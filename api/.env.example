# Redis connection for the API's own cache (the `kona-redis` fly app in production; the web
# app uses its own separate Upstash instance). Use rediss:// for TLS.
# ⚠️ On your own machine, leave this at the local Redis that `overmind start` runs. NEVER point it
# at the Upstash instance of web: that is a metered free tier, and `overmind start` also runs
# Sidekiq, whose idle BRPOP fetch loop makes approximately 9,000 commands each hour with no job at
# all. That uses a month of the quota in approximately two days, and nothing gives you a message.
REDIS_URL=redis://localhost:6379

# Size of the shared Redis connection pool (default 10). Sized to the widest consumer, which is
# a web request fanning out to parallel upstreams — not Sidekiq's concurrency. Raise it if
# ConnectionPool checkout timeouts appear.
REDIS_POOL_SIZE=

# Intervals.icu credentials, used to fetch activity stats.
ICU_ATHLETE_ID=
ICU_API_KEY=

# Font Awesome API token, used to fetch icon SVGs.
FONT_AWESOME_API_TOKEN=

# Whoop OAuth app credentials, used to fetch sleep/recovery/strain. The redirect URI must be
# registered in the Whoop developer dashboard (e.g. https://<your-admin-host>/whoop/callback).
# ⚠️ It must name the ADMIN host wherever API_HOST is set — the callback route isn't drawn on the
# public API host.
# WHOOP_CLIENT_SECRET also doubles as the HMAC key verifying POST /webhooks/whoop deliveries
# (register the webhook URL with Model Version V2 in the same dashboard).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=

# Owner authentication (Google OAuth) gating GET /whoop/auth and the Sidekiq UI at /sidekiq.
# Sign-in is restricted to OWNER_EMAIL (and its Google hosted domain). Create a Google OAuth 2.0
# Web client and register the callback https://<your-admin-host>/auth/google_oauth2/callback —
# ⚠️ the admin host, for the same reason as WHOOP_REDIRECT_URI above.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OWNER_EMAIL=

# ⚠️ Local only, and off unless set: any value puts OmniAuth in test mode, so /signin logs straight
# in as OWNER_EMAIL without contacting Google. Ignored outside RAILS_ENV=development. Set it to work
# on admin pages without a Google round-trip; leave it unset to exercise the real sign-in.
DEV_OWNER_SIGNIN=

# Google Maps API key. Reverse-geocodes the location into a timezone/country/elevation,
# and powers the Google Air Quality (AQI fallback) and Pollen lookups for the weather widget.
GOOGLE_API_KEY=

# Bearer token required on the widget endpoints and the browser-reachable structured-data
# POSTs (POST /api/location, POST /api/contact), injected by the web app's proxy.
# Must match the web app's API_TOKEN.
API_TOKEN=

# Apple WeatherKit credentials, used to fetch the weather. WEATHERKIT_PRIVATE_KEY is the
# base64-encoded .p8 EC private key.
WEATHERKIT_KEY_ID=
WEATHERKIT_TEAM_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_PRIVATE_KEY=

# Contentful (read API), used by the weather widget to spot today's race and to sync
# standard.site records.
CONTENTFUL_SPACE=
CONTENTFUL_TOKEN=

# HMAC secret for verifying Contentful webhook requests (POST /webhooks/contentful).
# 64 chars matching /^[0-9a-zA-Z+/=_-]+$/; set the same value in the Contentful webhook's
# request-verification settings. Without it the webhook endpoint returns 401.
CONTENTFUL_WEBHOOK_SECRET=

# Rebuilds the web site: SiteBuildJob fires a GitHub repository_dispatch that the
# .github/workflows/web.yml "Web" workflow builds from. Two callers, one event type each —
# Webhooks::ContentfulController ("contentful-publish", on publish/unpublish/delete) and
# POST /api/build ("api-build", an on-demand rebuild). Both vars must be set or the trigger
# no-ops (dev/CI stay inert).
# GITHUB_DISPATCH_TOKEN: a fine-grained PAT scoped to this repo with Contents: Read and write
#   (repository_dispatch needs write access), or a classic PAT with the `repo` scope.
# GITHUB_REPOSITORY: the "owner/repo" slug to dispatch to.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=

# Cloudflare R2 bucket mirroring Contentful's image assets, which the web site serves every
# image from (AssetMirror, driven by the Contentful webhook + `rake assets:backfill`). All four
# must be set or the mirror no-ops, so dev/CI stay inert.
# ⚠️ CROSS-APP CONTRACT: the bucket must be the one behind the web app's IMAGE_HOST, and objects
# are keyed on Contentful's path verbatim. A mismatch 404s every image on the site, silently —
# nothing on either side validates it. See the root CLAUDE.md.
# R2_ACCOUNT_ID: the Cloudflare account id (the S3 endpoint's subdomain).
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: an R2 API token with object read/write on the bucket.
# R2_BUCKET: the bucket name.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# The cover image on the trending-articles card. Both must have a value, or the card renders no
# image at all. Use the same values as the web app.
# ⚠️ IMAGES_URL is the host that Cloudflare Images serves each transformation from
# (<host>/cdn-cgi/image/...), that is, the public host of the site.
# ⚠️ IMAGE_HOST is the host name of the R2 image mirror, with no scheme. The helper changes each
# ctfassets host to it. The Cloudflare Transformations list holds the mirror host only, thus a
# ctfassets source gets a 403 — never fall back to one. See the root CLAUDE.md.
IMAGES_URL=
IMAGE_HOST=

# Public site root URL (no trailing slash), used as the standard.site publication `url`, the
# contact form's no-JS success/error redirect target, and Akismet's `blog` param.
# NEVER hardcode the production hostname; this is environment-specific.
SITE_URL=

# Contact form (POST /api/contact). The submission is emailed to CONTACT_TO_ADDRESS via the
# Resend HTTP API, with Reply-To set to the sender, and spam-checked with Akismet.
#   RESEND_API_KEY               Resend API key (HTTPS, so it works from fly, which blocks SMTP)
#   CONTACT_FROM_ADDRESS         sender address on a domain verified in Resend. Resend needs only
#                                SPF/DKIM records, so it coexists with a Google Workspace mailbox
#                                on the same domain (it never touches the root MX). Never
#                                hardcode the host — it's environment-specific.
#   CONTACT_TO_ADDRESS           where contact-form messages are delivered (your inbox).
#   AKISMET_API_KEY              Akismet API key for the spam check (fails open when unset)
#   TURNSTILE_SECRET             Cloudflare Turnstile secret key for server-side siteverify of the
#                                form's bot-challenge token (fails open when unset). Pair it with
#                                the web app's TURNSTILE_SITE_KEY — set both together or neither.
RESEND_API_KEY=
CONTACT_FROM_ADDRESS=
CONTACT_TO_ADDRESS=
AKISMET_API_KEY=
TURNSTILE_SECRET=


######################################
# The variables below are all OPTIONAL
######################################

# Comma-separated allowlist of Host headers accepted in production (DNS-rebinding / Host-header
# protection). List every host the origin is reached by — the custom API host plus the .fly.dev
# fallback if the proxy uses it, e.g. "<your-api-host>,<your-app>.fly.dev". NEVER hardcode the
# production hostname. When unset, all hosts are accepted (host authorization stays off). The
# /up health check is always exempt. Only consulted in production.
# ⚠️ Think twice before listing the .fly.dev origin. API_HOST never matches there, so the whole
# owner-facing surface — /signin, the OAuth callback, /sidekiq, the admin UI — IS drawn on it, and
# that hostname doesn't traverse the Cloudflare zone, so the WAF and Super Bot Fight Mode don't
# apply. Leaving it out is what makes host authorization the thing that closes that door.
ALLOWED_HOSTS=

# The public API hostname (host only — no scheme, no port). When set, the owner-facing routes
# (/login, /logout, /auth/*, /whoop/auth, /whoop/callback, /sidekiq) are drawn only off the
# origin's *other* hostnames, i.e. the admin host, leaving this one serving nothing but /up,
# /api/*, /widgets/*, and /webhooks/*. Unset draws every route on every host, which is what dev,
# CI, and the .fly.dev origin want. NEVER hardcode the production hostname.
# ⚠️ Point WHOOP_REDIRECT_URI and the Whoop dashboard at the admin host before setting this, or
# the OAuth callback 404s. The zone's bot-protection skip rule depends on this split — see the
# root CLAUDE.md.
API_HOST=

# Enforce the owner-facing Content-Security-Policy instead of only reporting it. Any value turns
# it on; unset means the header is sent as Content-Security-Policy-Report-Only, so a source the
# policy forgot shows up in the console rather than as a blank admin page. The policy itself is in
# app/controllers/concerns/owner_facing.rb and applies to no other response.
CSP_ENFORCE=

# Font Awesome version to fetch icons for. Defaults to 7.3.0.
FONT_AWESOME_VERSION=

# Whoop referral link shown under the Whoop widget. Hidden if unset.
WHOOP_REFERRAL_URL=

# Anthropic API key, used for the auto-generated activity descriptions on Whoop workout.updated
# webhooks (the planned-workout headline and weather sentence) and for the contact form's
# Claude-generated email subject line. When unset, those lines are skipped and descriptions are
# composed from the programmatic blocks only, and the contact email uses a static subject.
ANTHROPIC_API_KEY=
# Optional model override for the description generator. Defaults to claude-sonnet-5.
ANTHROPIC_DESCRIPTION_MODEL=
# Optional model override for the contact form's subject-line generator. Defaults to
# claude-sonnet-5 (claude-haiku-4-5 is a cheaper option that's more than enough for a subject).
ANTHROPIC_CONTACT_SUBJECT_MODEL=

# Goodspeed API endpoint, returning San Francisco Bay water temperature and tidal current as a
# timeseries. When unset the integration is off: the weather summary omits the bay water
# temperature and San Francisco events render without bay conditions.
GOODSPEED_API_URL=

# PurpleAir API key, used for the weather widget's AQI (nearest US sensor). Falls back to
# the Google Air Quality API when unset or no sensor is nearby.
PURPLEAIR_API_KEY=

# Mapbox, for two admin pages: Maps (GPX tracks uploaded as private vector tilesets and rendered
# as static map images) and Location (a map you drop a pin on). Each says so when what it needs is
# unset — uploads are refused, and the Location page degrades to a coordinate form. Nothing else
# in the app touches Mapbox, so dev and CI stay inert.
#   MAPBOX_USERNAME       the Mapbox account username, which prefixes every tileset id.
#   MAPBOX_SECRET_TOKEN   a secret token with `tilesets:write` and `tilesets:read`. Required to
#                         upload, and preferred for *server-side* rendering — it's the only one
#                         that can read the private tilesets the upload creates.
#   MAPBOX_ACCESS_TOKEN   the public token. Renders server-side when there's no secret token, and
#                         is what the Location page's browser map needs.
#                         ⚠️ Public because it reaches the browser. Never put a secret token here.
#   MAPBOX_STYLE_URL      OPTIONAL default style for new tracks; each track can override it.
#                         Defaults to mapbox://styles/mapbox/outdoors-v12. The Location page uses
#                         its own basemap and ignores this.
MAPBOX_USERNAME=
MAPBOX_SECRET_TOKEN=
MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE_URL=

# Current location as a "latitude,longitude" pair. ⚠️ Overrides the stored location, so with this
# set the admin's Location page can still drop a pin but nothing will read it. Requires
# GOOGLE_API_KEY for timezone lookups.
LOCATION=

# Fallback timezone used when no location/geocoding is available. Defaults to America/Denver.
TIME_ZONE=

# Plausible Analytics, for the pageview counter and the trending ranking. The code needs both.
# With either one absent, the pageviews widget goes away and TrendingArticles changes to the order
# by popularity with no message. An INFO log is the only sign, and the result looks exactly like
# "it operates, and nothing is trending". PLAUSIBLE_SITE_ID is the domain of the site in
# Plausible.
# ⚠️ The API permits 600 calls each hour, and the number of *different* queries is what counts.
# Read api/CLAUDE.md before you add one.
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=

# The tuning of the trending widget. Each one is optional, and the defaults are correct.
# ⚠️ These go into the cache key of the ranking. Thus a change to one makes the cached list
# invalid by itself, and no person changes a version number.
#   TRENDING_RECENT_WINDOW_HOURS      the flat moving recent window, in hours (default 48)
#   TRENDING_BASELINE_DAYS            how far back the baseline of each post reaches (default 30)
#   TRENDING_SCORE_RELATIVE_WEIGHT    the weight of the surge term (default 1)
#   TRENDING_SCORE_ABSOLUTE_WEIGHT    the weight of the volume term (default 0.5, thus surge leads)
#   TRENDING_SURGE_PRIOR              the prior on BOTH sides of the surge ratio (default 3)
#   TRENDING_FLOOR_PERCENTILE         the floor, as a percentile of the articles with traffic
#                                     (default 0.5)
#   TRENDING_INTERNAL_WEIGHT          the weight of a reader who reaches the article from another
#                                     page of the site (default 0.5). 0 counts the demand from
#                                     outside the site alone.
# ⚠️ TRENDING_SURGE_PRIOR is what makes the score correct at low traffic. It moves a ratio from a
# small count toward 1, which is "no surge". A smaller value lets 3 or 4 visitors look like a
# surge.
# ⚠️ Keep TRENDING_INTERNAL_WEIGHT below 1. The widget renders on the home page and on each Page,
# thus its own clicks are part of the internal count. At a weight of 1 the widget orders its own
# output, and an article stays there because it is already there.
TRENDING_RECENT_WINDOW_HOURS=
TRENDING_BASELINE_DAYS=
TRENDING_SCORE_RELATIVE_WEIGHT=
TRENDING_SCORE_ABSOLUTE_WEIGHT=
TRENDING_SURGE_PRIOR=
TRENDING_FLOOR_PERCENTILE=
TRENDING_INTERNAL_WEIGHT=

# The tuning of the "You May Also Like" ranking. Each one is optional.
# ⚠️ No cache holds that ranking, thus a change here applies at the next build.
#   RELATED_LEXICAL_WEIGHT    the weight of the BM25 similarity; the concept overlap gets the rest
#                             (default 0.65)
#   RELATED_MMR_LAMBDA        1.0 is relevance only, and 0.0 is diversity only (default 0.7)
#   RELATED_FLOOR_SIGMAS      the floor, in standard deviations above the mean score (default 0.5)
# Use `rake related:audit` and `rake related:inspect[slug]` to see the effect of a change. No A/B
# test can operate at the traffic of this site.
RELATED_LEXICAL_WEIGHT=
RELATED_MMR_LAMBDA=
RELATED_FLOOR_SIGMAS=

# Publishes the blog to the AT Protocol as standard.site records (webhook-driven, plus the
# standard_site:backfill rake task). Until an account is connected, the standard.site webhook +
# endpoint no-op and the site omits verification markup.
#
# ⚠️ There is no env var for the Bluesky handle or app password. They're entered on the admin's
# Connected apps page and stored (encrypted) in Redis — that page is the only way to set them.
#
# Optional PDS host; defaults to https://bsky.social.
BLUESKY_PDS_URL=

# Threads (Meta). Create a Threads app at developers.facebook.com, then copy its Threads App ID and
# Threads App Secret here. Add https://<your-admin-host>/connected-apps/threads/callback to the app's
# list of redirect callback URLs.
#
# ⚠️ The app requests the threads_basic and threads_content_publish scopes (Threads::SCOPES). Enable
# both on the app, or the authorization screen fails with no useful message. Publishing is only for
# a later use; nothing posts today.
#
# ⚠️ There is no redirect-URI env var, unlike WHOOP_REDIRECT_URI: the callback URL comes from the
# request, thus it always names the admin host, which is the only host that draws that route.
#
# ⚠️ The account itself is connected on the admin's Connected apps page, and its token is stored
# (encrypted) in Redis. That token lives 60 days and an expired one CANNOT be renewed —
# ThreadsTokenRefreshJob renews it daily, so the worker process must be running.
#
# ⚠️ There is no env var for a Mastodon account at all: the app registers itself on whichever
# instance the owner names on that same page.
THREADS_APP_ID=
THREADS_APP_SECRET=

# Bugsnag project API key for error reporting. Only production notifies; unset locally
# and in CI, where exception reporting is a no-op.
BUGSNAG_API_KEY=
