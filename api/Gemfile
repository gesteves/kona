source "https://rubygems.org"

# Matches .ruby-version and web/Gemfile, so a mismatched Ruby fails at `bundle install` here
# too rather than only on the web side.
ruby "4.0.6"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.1.3"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# HTTP client for the Intervals.icu, Whoop, Google Maps, and Font Awesome APIs
gem "httparty"
# Parses the TrainerRoad calendar (iCalendar) feed
gem "icalendar"
# Parses uploaded GPX tracks for the admin's map renderer. Already resolved transitively (via
# sanitize), but declared because GpxTrack requires it directly. Precompiled platform gems ship a
# statically-linked libxml2, so this adds no system packages to the Docker image.
gem "nokogiri"
# Signs the ES256 JWT used to authenticate with Apple WeatherKit
gem "jwt"
# Renders the Markdown weather summary (bold + SmartyPants), and the standard.site
# document text (stripped to plain text via the gems below)
gem "redcarpet"
# Strips rendered Markdown to plain text for the standard.site document fields
gem "sanitize"
# Decodes HTML entities left by the Markdown→plain-text pass for standard.site
gem "htmlentities"
# Redis caching (uses the API's own REDIS_URL — the dedicated kona-redis instance)
gem "redis"
# Pools that Redis client. Declared explicitly rather than leaned on as a Sidekiq transitive
# dependency, since config/initializers/redis.rb requires it directly.
gem "connection_pool"
# Background job queue (standard.site PDS sync) + its web UI. Stores queues in the same Redis.
gem "sidekiq"
# Runs the recurring Whoop token refresh inside the same Sidekiq worker process. Requires
# sidekiq >= 7.3; rufus-scheduler is its only runtime dependency and is pure Ruby.
gem "sidekiq-scheduler"
# Owner authentication for /whoop/auth and the Sidekiq UI: Google OAuth restricted to one identity.
# omniauth-rails_csrf_protection forces the OmniAuth request phase to be a CSRF-protected POST.
gem "omniauth-google-oauth2"
gem "omniauth-rails_csrf_protection"
# Condenses Rails' multi-line request logs into one structured line per request
gem "lograge"
# Caps total request wall-time so no single request can hold a Puma thread indefinitely
gem "rack-timeout"
# Blocks/throttles abusive direct-to-origin requests (vulnerability scanners) at the edge of
# the middleware stack, before they reach routing. See config/initializers/rack_attack.rb.
gem "rack-attack"
# Reports unhandled exceptions to Bugsnag (production only). See
# config/initializers/bugsnag.rb.
gem "bugsnag"
# Official Anthropic SDK, used to generate activity descriptions (planned-workout summary
# + weather sentence) on Whoop workout webhooks. Structured outputs guarantee parseable
# JSON, and per-request timeouts sidestep the global HTTParty read timeout.
gem "anthropic"
# GraphQL client for the Font Awesome API
gem "graphql-client"
# Faster JSON parsing/serialization for the read-through Redis cache and service responses
gem "oj"
# S3-compatible client for Cloudflare R2, which mirrors Contentful's image assets so the
# site's images are served from our own zone instead of Contentful. See AssetMirror.
gem "aws-sdk-s3"
# Caches Ruby bytecode + YAML/require lookups to speed boot (the fly machine auto-stops)
gem "bootsnap", require: false
# Serves and fingerprints the admin UI's assets. Digest-only — no transpiling, no import-specifier
# rewriting, which is why the JS is bundled before it gets here.
gem "propshaft"
# Wires `npm run build` into assets:precompile so esbuild's output is there to fingerprint.
gem "jsbundling-rails"

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
  # Loads environment variables from .env for local development (production uses real env/secrets)
  gem "dotenv-rails"
  # Static analysis security scanner; run in CI (bin/ci) and the GitHub Actions security job.
  gem "brakeman", require: false
  # Scans the bundle for gems with known CVEs; run alongside Brakeman in CI.
  gem "bundler-audit", require: false
  # Rails' own RuboCop ruleset, inherited verbatim (see .rubocop.yml). It enables 50 of RuboCop's
  # 609 cops — layout and a few style ones, and deliberately no Metrics or Naming.
  gem "rubocop-rails-omakase", require: false
end

group :test do
  gem "rspec-rails"
  # Readable matchers for asserting enqueued Sidekiq jobs (have_enqueued_sidekiq_job)
  gem "rspec-sidekiq"
end
