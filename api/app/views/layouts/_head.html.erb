<%# Shared <head> for the two owner-facing layouts (admin, auth). Both load the same bundle;
    nothing here is public, hence the blanket noindex. %>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title><%= [ title.presence, "Given to Tri" ].compact.join(" · ") %></title>
<%# ⚠️ Declared explicitly, and served from public/ rather than through Propshaft. Without a
    declaration the browser keeps whatever it last saw for this origin — which is Sidekiq's own
    icon, since Sidekiq::Web ships one and the admin didn't. A fingerprinted /assets path wouldn't
    fix a bookmark either: that's a bare /favicon.ico request, which only public/ answers. %>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<%= csrf_meta_tags %>
<%# Turbo re-applies this nonce to any script it inserts, and refreshes the tag on every visit —
    which is why the nonce can be per-request without breaking a Drive navigation. %>
<%= csp_meta_tag %>

<script nonce="<%= content_security_policy_nonce %>">
  // Web Awesome's dark theme is keyed on a `.wa-dark` class, not on prefers-color-scheme, so map
  // the OS preference onto it here. Inline and before paint, so there's no flash of the light
  // theme; Turbo replaces <body> and merges <head> but never <html>, so the class survives Drive
  // visits and only needs setting on a full load.
  // ⚠️ The nonce is what lets this run under the CSP in OwnerFacing. Don't drop it, and don't move
  // this into the bundle — it has to execute before paint.
  (function () {
    var query = window.matchMedia("(prefers-color-scheme: dark)");
    var apply = function (event) {
      document.documentElement.classList.toggle("wa-dark", event.matches);
    };
    apply(query);
    query.addEventListener("change", apply);
  })();
</script>

<%# ⚠️ Never mutate an attribute of a data-turbo-track element at runtime — Turbo folds its
    outerHTML into the tracked-element signature, so a change turns every navigation into a full
    page reload. %>
<%= stylesheet_link_tag "admin", "data-turbo-track": "reload" %>
<%= javascript_include_tag "admin", defer: true, "data-turbo-track": "reload" %>
