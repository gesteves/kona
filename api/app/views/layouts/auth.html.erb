<%# The layout of the sign-in page. It is not a <wa-page>, on purpose: this page is one card at the
    center, and the slots and the `view` state of that component do nothing outside a full app
    shell. %>
<%# Refer to layouts/admin.html.erb for the reason that `wa-brand-red` is here. %>
<!DOCTYPE html>
<html lang="en" class="wa-brand-red">
  <head>
    <%= render "layouts/head", title: yield(:title) %>
  </head>

  <body>
    <main class="signin wa-cloak">
      <%= yield %>
    </main>
  </body>
</html>
