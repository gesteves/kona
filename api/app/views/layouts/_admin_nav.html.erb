<%# The links of the admin sidebar: a short list with no group, then the other links in groups with
    a caption. Both come from AdminHelper, and layouts/_admin_nav_item renders both. %>
<div class="wa-stack wa-gap-m">
  <ul class="plain-list wa-stack wa-gap-3xs">
    <%= render partial: "layouts/admin_nav_item", collection: admin_nav_items, as: :item %>
  </ul>

  <% admin_nav_groups(quarantine_count: @quarantine_count).each do |group| %>
    <%# ⚠️ The id comes from :key, and NOT from the label. The label is a translation, thus an id
        from it would change with a change to a word, and `aria-labelledby` points at that id. %>
    <% label_id = "admin-nav-#{group[:key]}" %>
    <div class="wa-stack wa-gap-3xs">
      <%# ⚠️ This is a <div>, and not a heading element. It names a list of links, and a true heading
          here would come before the <h1> of the page. `aria-labelledby` gives the connection to the
          assistive technology, and that is the work that a heading did. %>
      <div class="admin-nav__group-label wa-caption-s" id="<%= label_id %>"><%= group[:label] %></div>

      <ul class="plain-list wa-stack wa-gap-3xs" aria-labelledby="<%= label_id %>">
        <%= render partial: "layouts/admin_nav_item", collection: group[:items], as: :item %>
      </ul>
    </div>
  <% end %>
</div>
