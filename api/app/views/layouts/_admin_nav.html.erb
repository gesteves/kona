<%# The admin sidebar's links: a short ungrouped list, then the rest under labelled groups.
    Both come from AdminHelper, and both render through layouts/_admin_nav_item. %>
<div class="wa-stack wa-gap-m">
  <ul class="plain-list wa-stack wa-gap-3xs">
    <%= render partial: "layouts/admin_nav_item",
               collection: admin_nav_items(quarantine_count: @quarantine_count), as: :item %>
  </ul>

  <% admin_nav_groups.each do |group| %>
    <% label_id = "admin-nav-#{group[:label].parameterize}" %>
    <div class="wa-stack wa-gap-3xs">
      <%# ⚠️ A <div>, not a heading element: this labels a list of links, and a real heading here
          would land ahead of the page's own <h1>. `aria-labelledby` carries the association to
          assistive tech instead, which is the part a heading was doing. %>
      <div class="admin-nav__group-label wa-caption-s" id="<%= label_id %>"><%= group[:label] %></div>

      <ul class="plain-list wa-stack wa-gap-3xs" aria-labelledby="<%= label_id %>">
        <%= render partial: "layouts/admin_nav_item", collection: group[:items], as: :item %>
      </ul>
    </div>
  <% end %>
</div>
