<%# The Republish dialog. The layout renders it one time, and the "Republish site" item of the nav
    opens it with `data-dialog="open"`. Thus each admin page can start a build of the web site.
    ⚠️ It is a sibling of <wa-page>, and not a child. That component moves its `slot="navigation"`
    content between the sidebar and the drawer, and this dialog must not travel with it. %>
<%# ⚠️ The two footer buttons are outside the <form>, because a slot takes a direct child of the
    dialog only. `form="republish-form"` is what makes the submit button part of that form: a
    form-associated element reads that attribute, as a native control does. %>
<wa-dialog id="<%= AdminHelper::REPUBLISH_DIALOG_ID %>" label="Republish the site"
           data-controller="dialog republish">
  <%# One control, and no radio group: a delay of zero minutes is "now". The label of the submit
      button says which of the two the value gives. %>
  <%= form_with url: republish_path, method: :post, id: "republish-form",
                data: { republish_target: "form", action: "submit->republish#markBusy" } do %>
    <wa-number-input name="minutes" label="Delay in minutes" required
                     value="<%= Admin::RepublishController::DEFAULT_MINUTES %>"
                     min="<%= Admin::RepublishController::MIN_MINUTES %>"
                     max="<%= Admin::RepublishController::MAX_MINUTES %>" step="1"
                     data-republish-target="minutes"
                     data-action="input->republish#relabel change->republish#relabel
                                  keydown->republish#submitOnEnter">
    </wa-number-input>
  <% end %>

  <wa-button slot="footer" appearance="outlined" data-dialog="close">Cancel</wa-button>
  <wa-button slot="footer" type="submit" form="republish-form" variant="brand" appearance="accent"
             data-republish-target="submit">
    <%= slotted_icon_svg("classic", "light", "arrows-rotate") %>
    <span data-republish-target="label">Republish</span>
  </wa-button>
</wa-dialog>
