<%#
  One event card of the races widget. The locals: `event`; `featured`, which is a boolean and which
  gives a large card; `event_weather`, which is an EventWeatherPresenter or nil and which is the
  race-day weather of the featured event; `time_zone`, which is an IANA id for the check that the
  race occurs now; and `show_timestamp`, which is a boolean whose default is true. Give false for
  the race of today, whose section heading already says the day.
%>
<article class="entry entry--summary event<%= " event--is-featured" if featured %>" id="event-<%= event.sys.id.parameterize %>" aria-labelledby="hed-<%= event.sys.id.parameterize %>">
  <div class="event__inner">
    <header class="entry__header">
      <p class="entry__meta">
        <% if featured %><%= event_live_tracking_tag(event, time_zone, event_weather: event_weather) %><% end %>
        <% if local_assigns.fetch(:show_timestamp, true) %><%= event_timestamp_tag(event) %><% end %>
        <span><%= raw icon_svg("classic", "light", "location-dot") %> <%= event.location %></span>
      </p>
      <h3 class="entry__hed" id="hed-<%= event.sys.id.parameterize %>">
        <% if event.url.present? %>
          <%= link_to raw(smartypants(event.title)), event.url, rel: "noopener", target: "_blank" %>
        <% else %>
          <%= raw smartypants(event.title) %>
        <% end %>
      </h3>
    </header>
    <div class="entry__body">
      <%= raw render_summary_body(featured ? (event.description.presence || event.summary) : event.summary) %>
    </div>
  </div>
  <% if event_weather.present? %>
    <%= render "event_weather", event_weather: event_weather %>
  <% end %>
</article>
