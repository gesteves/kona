<%#
  The races widget, served as a live-update fragment the static site swaps in. The outer
  wrapper carries the live-update attributes; it's display:contents, so the inner <section>s
  lay out directly in the page grid. Off race day it holds a single "Upcoming Races" section
  (the first event featured — expanded card + inline race-day weather — when within 10 days).
  On race day, today's race gets its own "Today's Race" section with that weather, and the
  remaining races follow under "Upcoming Races".
%>
<div class="collection-group" data-nosnippet <%= live_update_attrs %>>
  <% if @races.todays_race %>
    <section class="collection collection--single collection--has-featured" id="todays-race" aria-labelledby="hed-todays-race">
      <h2 class="collection__heading" id="hed-todays-race">Today’s Race</h2>
      <ol class="collection__list">
        <li class="collection__item">
          <%# show_timestamp: false — the "Today's Race" heading already says it's today. %>
          <%= render "event", event: @races.todays_race, featured: true, event_weather: @races.event_weather, time_zone: @races.time_zone, show_timestamp: false %>
        </li>
      </ol>
    </section>
    <% if @races.other_races.present? %>
      <section class="collection collection--<%= @races.other_races_variant %>" id="upcoming-races" aria-labelledby="hed-upcoming-races">
        <h2 class="collection__heading" id="hed-upcoming-races">Upcoming Races</h2>
        <ol class="collection__list">
          <% @races.other_races.each do |event| %>
            <li class="collection__item">
              <%= render "event", event: event, featured: false, event_weather: nil, time_zone: @races.time_zone %>
            </li>
          <% end %>
        </ol>
      </section>
    <% end %>
  <% else %>
    <section class="collection collection--<%= @races.variant %><%= " collection--has-featured" if @races.featured %>" id="upcoming-races" aria-labelledby="hed-upcoming-races">
      <h2 class="collection__heading" id="hed-upcoming-races">Upcoming Races</h2>
      <ol class="collection__list">
        <% @races.races.each do |event| %>
          <% featured = @races.featured_event?(event) %>
          <li class="collection__item">
            <%= render "event", event: event, featured: featured, event_weather: (featured ? @races.event_weather : nil), time_zone: @races.time_zone %>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>
</div>
