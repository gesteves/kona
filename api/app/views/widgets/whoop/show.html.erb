<section data-nosnippet class="stats stats--has-three" <%= live_update_attrs %> aria-labelledby="hed-whoop">
  <h2 class="stats__heading" id="hed-whoop"><%= @whoop.heading_label %> Metrics <i>from</i> <a href="https://www.whoop.com" target="_blank" rel="nofollow noopener">Whoop</a></h2>
  <div class="stats__container">
    <%= render "widgets/activity_stats/stat", icon: "moon",                 top: "Sleep",    value: @whoop.sleep_score,    unit: "%",   bottom: @whoop.sleep_label %>
    <%= render "widgets/activity_stats/stat", icon: @whoop.recovery_icon,   top: "Recovery", value: @whoop.recovery_score, unit: "%",   bottom: @whoop.recovery_label %>
    <%= render "widgets/activity_stats/stat", icon: "fire-flame-curved",    top: "Strain",   value: @whoop.strain_score,   unit: "/21", bottom: @whoop.strain_label %>
  </div>
  <% if @whoop.referral_url %>
    <p class="stats__footer">
      <%= link_to "Join Whoop <i>and</i> get one month free".html_safe, @whoop.referral_url, target: "_blank", rel: "nofollow noopener sponsored" %>
    </p>
  <% end %>
</section>
