<%#
  Shared shell for the article-collection widgets (trending + related), served as a live-update
  fragment the static site swaps in. The outer <section> carries the live-update attributes so
  it keeps refreshing after the swap (and on visibilitychange).
%>
<section class="collection collection--halves" id="<%= section_id %>" aria-labelledby="hed-<%= section_id %>" data-nosnippet <%= live_update_attrs %>>
  <h2 class="collection__heading" id="hed-<%= section_id %>"><%= heading %></h2>
  <ol class="collection__list">
    <% articles.each do |article| %>
      <li class="collection__item">
        <%# section_id scopes the card's ids: trending and related can both list the same article
            on one page, and unscoped ids would collide and mis-resolve aria-labelledby. %>
        <%= render "summary", article: article, section_id: section_id %>
      </li>
    <% end %>
  </ol>
</section>
