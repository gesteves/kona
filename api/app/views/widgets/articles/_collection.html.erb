<%#
  Shell for the trending-articles widget, served as a live-update fragment the static site swaps
  in. The outer <section> carries the live-update attributes so it keeps refreshing after the swap
  (and on visibilitychange). Still a partial, and still parameterised by section, because the
  related-articles widget shared it until that section moved into the build.
%>
<section class="collection collection--halves" id="<%= section_id %>" aria-labelledby="hed-<%= section_id %>" data-nosnippet <%= live_update_attrs %>>
  <h2 class="collection__heading" id="hed-<%= section_id %>"><%= heading %></h2>
  <ol class="collection__list">
    <% articles.each do |article| %>
      <li class="collection__item">
        <%# section_id scopes the card's ids against the sections the STATIC build renders on the
            same page — related articles and read-next both list summary cards, and unscoped ids
            would collide and mis-resolve aria-labelledby. %>
        <%= render "summary", article: article, section_id: section_id %>
      </li>
    <% end %>
  </ol>
</section>
