<%#
  Shared shell for the article-collection widgets (trending + related), served as a live-update
  fragment the static site swaps in. The outer <section> carries the live-update attributes so
  it keeps refreshing after the swap (and on visibilitychange).
%>
<section class="collection collection--halves" id="<%= section_id %>" data-nosnippet <%= live_update_attrs %>>
  <h2 class="collection__heading"><%= heading %></h2>
  <ol class="collection__list">
    <% articles.each do |article| %>
      <li class="collection__item">
        <%= render "summary", article: article %>
      </li>
    <% end %>
  </ol>
</section>
