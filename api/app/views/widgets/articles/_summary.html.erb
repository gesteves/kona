<%#
  The summary card of an article, for the trending section. Its local is `article`. This code comes
  from partials/article/_summary.html.erb of the static site. The small renderer makes the body
  text.
%>
<% published_at = DateTime.parse(article.published_at) %>
<%# The section is part of each id: the same article can be here and in a section from the build on
    the same page, that is, the related articles or the read-next section. %>
<% entry_id = "#{section_id}-#{article.sys.id.parameterize}" %>
<article class="entry entry--summary" id="entry-<%= entry_id %>" aria-labelledby="hed-<%= entry_id %>">
  <%# ⚠️ The link is aria-hidden and it is not a tab stop, and the image has an empty alt. The
      headline below links to the same page. Without this, each card gives two identical tab stops
      and two identical entries in the link list of a screen reader.
      ⚠️ Keep this markup the same as web/source/partials/article/_summary.html.erb. The two cards
      go on the same page, and no check compares them. %>
  <% cover = cover_image_tag(article) %>
  <% if cover.present? %>
    <%= link_to cover, article.path, class: [ "entry__cover", article_click_classes(tracking_section) ].compact.join(" "), tabindex: "-1", "aria-hidden": "true" %>
  <% end %>
  <header class="entry__header">
    <p class="entry__meta"
      data-controller="publish-date"
      data-publish-date-datetime-value="<%= published_at.iso8601 %>"
      data-publish-date-time-zone-value="<%= site_time_zone %>"
      data-publish-date-entry-type-value="<%= article.entry_type %>"
      data-publish-date-draft-value="<%= article.draft %>">
      <span class="entry__highlight" data-publish-date-target="badge" hidden><%= raw icon_svg("classic", "regular", "sparkles") %> New</span>
      <span>
        <span data-publish-date-target="clock" hidden><%= raw clock_icon_svg(published_at) %></span>
        <span data-publish-date-target="calendar"><%= raw icon_svg("classic", "light", "calendar") %></span>
        <%= article_permalink_timestamp(article, link_class: article_click_classes(tracking_section)) %>
      </span>
    </p>
    <h3 class="entry__hed" id="hed-<%= entry_id %>">
      <%= link_to raw(smartypants(article.title)), article.path, class: article_click_classes(tracking_section) %>
    </h3>
  </header>
  <div class="entry__body">
    <%= raw render_summary_body(article.summary) %>
  </div>
</article>
