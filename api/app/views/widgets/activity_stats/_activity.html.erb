<%# Each conversion is formatted once and reused; distance_value/distance_unit would each redo it. %>
<% metric_value, metric_unit = distance_parts(distance) %>
<% imperial_value, imperial_unit = distance_parts(distance, units: "imperial") %>
<div class="stats__stat">
  <span class="stats__meta"><% if local_assigns[:icon] %><%= raw icon_svg("classic", "light", icon) %> <% end %><%= activity %></span>
  <span class="stats__number" data-controller="units" data-units-imperial-value="<%= imperial_value %>" data-units-metric-value="<%= metric_value %>"><%= metric_value %></span>
  <span class="stats__meta"   data-controller="units" data-units-imperial-value="<%= imperial_unit %>"   data-units-metric-value="<%= metric_unit %>"><%= metric_unit %></span>
</div>
