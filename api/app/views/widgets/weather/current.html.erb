<section class="weather" data-nosnippet <%= live_update_attrs %> aria-labelledby="hed-weather">
  <%# ⚠️ The heading is sr-only, and each other widget has a visible one. This widget is a
      sentence and its design has no heading, but with no name it is not a landmark and a screen
      reader cannot reach it, and the swap of the fragment for the skeleton is then silent.
      ⚠️ Keep this the same as the other side of the pair. %>
  <h2 class="sr-only" id="hed-weather">Current conditions</h2>
  <div class="weather__icon" aria-hidden="true"><%= raw icon_svg("classic", "thin", @summary.icon) %></div>
  <div class="weather__text">
    <%= raw @summary.weather_summary %>
    <% @summary.alerts.each do |alert| %>
      <a href="<%= alert.details_url %>" class="weather__alert" target="_blank" rel="nofollow noopener">
        <%= raw icon_svg("classic", "light", "triangle-exclamation") %>
        <%= alert.description %>
      </a>
    <% end %>
  </div>
</section>
