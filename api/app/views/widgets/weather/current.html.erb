<div class="weather" data-nosnippet <%= live_update_attrs %>>
  <div class="weather__icon" aria-hidden="true"><%= raw icon_svg("classic", "thin", @summary.icon) %></div>
  <div class="weather__text">
    <%= raw @summary.weather_summary %>
    <% @summary.alerts.each do |alert| %>
      <a href="<%= alert.details_url %>" class="weather__alert" target="_blank" rel="nofollow noopener">
        <%= raw icon_svg("classic", "light", "triangle-exclamation") %>
        <%= alert.description %>
      </a>
    <% end %>
  </div>
</div>
