<%= render "layouts/page_header", title: t("admin.pages.connected_apps") %>

<ul class="admin-card-list plain-list wa-grid wa-gap-m">
  <% @apps.each do |app| %>
    <li>
      <wa-card class="admin-card">
        <div class="wa-stack wa-gap-m">
          <div class="wa-cluster wa-gap-s">
            <h2 class="admin-card__title wa-heading-m"><%= app.name %></h2>
            <wa-badge variant="<%= app.status_variant %>" appearance="outlined">
              <%= app.status_label %>
            </wa-badge>
          </div>

          <p class="admin-card__summary"><%= app.description %></p>

          <%# A reader can miss the badge alone, and this is the one state that needs an action. %>
          <% if app.error.present? %>
            <wa-callout variant="danger">
              <%= slotted_icon_svg("classic", "light", "triangle-exclamation", slot: "icon") %>
              <%= app.error %>
            </wa-callout>
          <% end %>

          <div class="wa-cluster wa-gap-s">
            <% if app.connectable? %>
              <%# ⚠️ This uses `turbo: false`, because the connect path of Whoop is a same-origin URL
                  that gives a 302 to another origin, and Turbo Drive cannot follow that. It is
                  necessary: Turbo goes into a shadow root and out of it. It finds the <a> in
                  wa-button through the composed path of the click, then it finds this attribute on
                  the host. It has no condition, because for an app whose connect path is an
                  ordinary admin page, such as the form of Bluesky, the only cost is a full page
                  load. %>
              <wa-button href="<%= app.connect_path %>" variant="brand" appearance="accent"
                         data-turbo="false">
                <%= slotted_icon_svg("classic", "light", "link") %>
                <%= app.connect_label %>
              </wa-button>
            <% end %>

            <%# This is not an `elsif`: an app in the error state offers both actions, because a new
                connection is the correction and a disconnect is the way out. %>
            <% if app.disconnectable? %>
              <%# The button opens the dialog below: wa-dialog listens on the full document for
                  [data-dialog="open <id>"]. ⚠️ The stored credentials are the only copy, thus the
                  delete needs a confirmation, as the Spam page and the Course maps page have.
                  ⚠️ Use neutral and not danger: the brand colors here are red. Red is for the
                  confirm button in the dialog only. %>
              <wa-button variant="neutral" appearance="outlined" data-dialog="open <%= app.disconnect_dialog_id %>">
                <%= slotted_icon_svg("classic", "light", "link-slash") %>
                <%= t(".disconnect") %>
              </wa-button>
            <% end %>
          </div>
        </div>
      </wa-card>

      <% if app.disconnectable? %>
        <wa-dialog id="<%= app.disconnect_dialog_id %>" label="<%= t(".disconnect_title", app: app.name) %>" data-controller="dialog">
          <p><%= t(".disconnect_body", app: app.name) %></p>

          <wa-button slot="footer" appearance="outlined" data-dialog="close"><%= t("admin.actions.cancel") %></wa-button>
          <%# This is a same-origin POST that acts as a DELETE, thus Turbo does it in the usual
              way. It uses form_with with a <wa-button> that is part of the form, and not
              button_to, which writes a native button. %>
          <%= form_with url: app.disconnect_path, method: :delete, html: { slot: "footer" } do %>
            <wa-button type="submit" variant="danger" appearance="accent"><%= t(".disconnect") %></wa-button>
          <% end %>
        </wa-dialog>
      <% end %>
    </li>
  <% end %>
</ul>
