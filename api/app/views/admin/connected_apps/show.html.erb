<% content_for :title, t("admin.pages.connected_apps") %>

<h1 class="admin-main__title"><%= t("admin.pages.connected_apps") %></h1>

<ul class="plain-list wa-stack wa-gap-m">
  <% @apps.each do |app| %>
    <li>
      <wa-card>
        <div class="wa-stack wa-gap-m">
          <div class="wa-cluster wa-gap-s">
            <h2 class="connected-app__name wa-heading-l"><%= app.name %></h2>
            <wa-badge variant="<%= app.status_variant %>" appearance="outlined">
              <%= app.status_label %>
            </wa-badge>
          </div>

          <p class="connected-app__description"><%= app.description %></p>

          <%# A reader can miss the badge alone, and this is the one state that needs an action. %>
          <% if app.error.present? %>
            <wa-callout variant="danger">
              <%= slotted_icon_svg("classic", "light", "triangle-exclamation", slot: "icon") %>
              <%= app.error %>
            </wa-callout>
          <% end %>

          <div class="wa-cluster wa-gap-s">
            <% if app.connectable? %>
              <%# ⚠️ This uses `turbo: false`, because the connect path of Whoop is a same-origin URL
                  that gives a 302 to another origin, and Turbo Drive cannot follow that. It is
                  necessary: Turbo goes into a shadow root and out of it. It finds the <a> in
                  wa-button through the composed path of the click, then it finds this attribute on
                  the host. It has no condition, because for an app whose connect path is an
                  ordinary admin page, such as the form of Bluesky, the only cost is a full page
                  load. %>
              <wa-button href="<%= app.connect_path %>" variant="brand" appearance="accent"
                         data-turbo="false">
                <%= app.connect_label %>
              </wa-button>
            <% end %>

            <%# This is not an `elsif`: an app in the error state offers both actions, because a new
                connection is the correction and a disconnect is the way out. %>
            <% if app.disconnectable? %>
              <%# This is a same-origin POST that acts as a DELETE, thus Turbo does it in the usual
                  way. It uses form_with with a <wa-button> that is part of the form, and not
                  button_to, which writes a native button. %>
              <%= form_with url: app.disconnect_path, method: :delete do %>
                <wa-button type="submit" variant="danger" appearance="outlined">
                  <%= slotted_icon_svg("classic", "light", "link-slash") %>
                  <%= t(".disconnect") %>
                </wa-button>
              <% end %>
            <% end %>
          </div>
        </div>
      </wa-card>
    </li>
  <% end %>
</ul>
