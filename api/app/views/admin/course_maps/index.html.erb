<% content_for :title, t("admin.pages.course_maps") %>

<h1 class="admin-main__title"><%= t("admin.pages.course_maps") %></h1>

<% unless @configured %>
  <wa-callout variant="warning" class="track-upload__notice">
    <%= slotted_icon_svg("classic", "light", "triangle-exclamation", slot: "icon") %>
    <%= t(".unconfigured_html", username: tag.code("MAPBOX_USERNAME"), token: tag.code("MAPBOX_SECRET_TOKEN")) %>
  </wa-callout>
<% end %>

<% if @worker_running == false %>
  <wa-callout variant="warning" class="track-upload__notice">
    <%= slotted_icon_svg("classic", "light", "triangle-exclamation", slot: "icon") %>
    <%= t(".no_worker_html", command: tag.code("overmind start")) %>
  </wa-callout>
<% end %>

<%# This uses form_with with a <wa-button> that is part of the form, and not button_to, which
    writes a native <button>. <wa-file-input> is also part of the form, thus the files go with the
    submission. %>
<%= form_with url: course_maps_path, method: :post, multipart: true, class: "track-upload" do %>
  <wa-file-input name="gpx_files[]" multiple accept=".gpx" label="<%= t(".files") %>"
                 hint="<%= t(".files_hint") %>">
  </wa-file-input>
  <wa-button type="submit" variant="brand" appearance="accent">
    <%= slotted_icon_svg("classic", "light", "arrow-up-from-bracket") %>
    <%= t(".upload") %>
  </wa-button>
<% end %>

<% if @tracks.empty? %>
  <wa-callout variant="neutral">
    <%= slotted_icon_svg("classic", "light", "route", slot: "icon") %>
    <%= t(".empty") %>
  </wa-callout>
<% else %>
  <%# The list reads the status while a track publishes, and then it stops. The tiling service of
      Mapbox is asynchronous, thus the server can send nothing to the page. %>
  <ul class="track-list plain-list wa-grid wa-gap-m" data-controller="map-status" data-map-status-url-value="<%= course_maps_status_path %>">
    <% @tracks.each do |track| %>
      <li data-map-status-id="<%= track.id %>" data-map-status-state="<%= track.status %>">
        <wa-card>
          <div class="wa-stack wa-gap-m">
            <div class="wa-cluster wa-gap-s">
              <h2 class="track__name wa-heading-l"><%= track.title %></h2>
              <wa-badge variant="<%= track.status_variant %>" appearance="outlined">
                <%= track.status_label %>
              </wa-badge>
              <wa-relative-time class="track__age wa-caption-s" date="<%= track.uploaded_at %>" sync></wa-relative-time>
            </div>

            <p class="track__summary"><%= track.summary %></p>

            <% if track.failed? && track.error %>
              <wa-callout variant="danger"><%= track.error %></wa-callout>
            <% end %>

            <div class="wa-cluster wa-gap-s">
              <% if track.ready? %>
                <wa-button href="<%= track.show_path %>" variant="brand" appearance="accent">
                  <%= slotted_icon_svg("classic", "light", "sliders") %>
                  <%= t(".open") %>
                </wa-button>
              <% elsif track.processing? %>
                <span class="wa-cluster wa-gap-xs wa-caption-s">
                  <wa-spinner></wa-spinner>
                  <%= t(".publishing") %>
                </span>
              <% end %>

              <%# Use neutral and not danger, for the same reason as on the spam cards: the brand
                  colors here are red. Thus a danger variant beside a brand-accent button makes the
                  safe action the most prominent one on the card. Red is for the confirm button in
                  the dialog only. %>
              <wa-button variant="neutral" appearance="outlined" data-dialog="open <%= track.dialog_id %>">
                <%= slotted_icon_svg("classic", "light", "trash") %>
                <%= t(".delete") %>
              </wa-button>
            </div>
          </div>
        </wa-card>

        <%# The markup opens the dialog: wa-dialog listens on the full document for
            [data-dialog="open <id>"] and [data-dialog="close"]. The `dialog` controller only closes
            it before Turbo caches the page. %>
        <wa-dialog id="<%= track.dialog_id %>" label="<%= t(".delete_title") %>" data-controller="dialog">
          <p><%= t(".delete_body_html", title: tag.strong(track.title)) %></p>

          <wa-button slot="footer" appearance="outlined" data-dialog="close"><%= t("admin.actions.cancel") %></wa-button>
          <%= form_with url: track.delete_path, method: :delete, html: { slot: "footer" } do %>
            <wa-button type="submit" variant="danger" appearance="accent"><%= t("admin.actions.delete_forever") %></wa-button>
          <% end %>
        </wa-dialog>
      </li>
    <% end %>
  </ul>
<% end %>
