<% content_for :title, @track.title %>

<p class="map-editor__back"><%= link_to "← All course maps", course_maps_path %></p>

<h1 class="admin-main__title"><%= @track.title %></h1>
<p class="map-editor__summary"><%= @track.summary %></p>

<%# In normal use the form never submits. The preview controller reads it and changes the image URL
    and the download URL in place. Thus a change to a value causes no navigation and the field that
    you edit keeps the focus. It stays a true GET form, thus Enter still works and a URL can always
    give the settings of a preview. %>
<div class="map-editor" data-controller="map-preview" data-map-preview-save-url-value="<%= course_map_path(@track.id) %>">
  <%= form_with url: @track.show_path, method: :get, class: "map-editor__settings",
                data: { map_preview_target: "form", turbo_action: "replace" } do %>

    <wa-details summary="Framing" open>
      <div class="wa-stack wa-gap-l">
        <%= render "sides", track: @track, prefix: "padding", linked_label: "Padding",
                            max: StaticMap::MAX_PADDING, step: 1,
                            hint: "Pixels between the track and the edge of the image." %>

        <%= render "sides", track: @track, prefix: "margin", linked_label: "Extra map",
                            max: StaticMap::MAX_MARGIN_KM, step: 0.5,
                            hint: "Kilometers of map added around the track. Widens the view rather than the border." %>

        <wa-input type="number" name="settings[height]" label="Height" value="<%= @track.setting('height') %>"
                  min="800" max="1280" step="1" placeholder="Auto"
                  hint="Leave blank to derive it from the track's shape. The image is always 1280 wide, and doubled on download.">
        </wa-input>
      </div>
    </wa-details>

    <wa-details summary="Track">
      <div class="wa-stack wa-gap-m">
        <wa-color-picker name="settings[track_color]" label="Line color"
                         value="<%= @track.setting('track_color') %>" format="hex">
        </wa-color-picker>
        <wa-number-input name="settings[track_width]" label="Line width"
                         value="<%= @track.setting('track_width') %>" min="1" max="20" step="0.5">
        </wa-number-input>
        <wa-slider name="settings[track_opacity]" label="Line opacity"
                   value="<%= @track.setting('track_opacity') %>" min="0" max="1" step="0.05" with-tooltip>
        </wa-slider>
      </div>
    </wa-details>

    <wa-details summary="Markers">
      <div class="wa-stack wa-gap-m">
        <wa-select name="settings[start_icon]" label="Start icon" value="<%= @track.setting('start_icon') %>">
          <% @icons.each do |id, name| %>
            <wa-option value="<%= id %>"><%= name %></wa-option>
          <% end %>
        </wa-select>
        <wa-color-picker name="settings[start_color]" label="Start color"
                         value="<%= @track.setting('start_color') %>" format="hex">
        </wa-color-picker>

        <wa-select name="settings[end_icon]" label="Finish icon" value="<%= @track.setting('end_icon') %>">
          <% @icons.each do |id, name| %>
            <wa-option value="<%= id %>"><%= name %></wa-option>
          <% end %>
        </wa-select>
        <wa-color-picker name="settings[end_color]" label="Finish color"
                         value="<%= @track.setting('end_color') %>" format="hex">
        </wa-color-picker>

        <%# The hidden field is what sends "off": a switch that is off sends nothing. The two fields
            have the same name, and the server takes the last one. That makes the pair a boolean. %>
        <input type="hidden" name="settings[finish_on_top]" value="0">
        <wa-switch name="settings[finish_on_top]" value="1"
                   <%= "checked" if ActiveModel::Type::Boolean.new.cast(@track.setting("finish_on_top")) %>
                   hint="Only matters when the two pins overlap, as on an out-and-back. The start pin is on top by default.">
          Draw the finish pin on top
        </wa-switch>
      </div>
    </wa-details>

    <wa-details summary="Style">
      <div class="wa-stack wa-gap-m">
        <wa-select name="settings[style_preset]" label="Base style" value="<%= @track.setting('style_preset') %>">
          <% @styles.each do |url, name| %>
            <wa-option value="<%= url %>"><%= name %></wa-option>
          <% end %>
        </wa-select>
        <wa-input name="settings[style_url]" label="Custom style" value="<%= @track.setting('style_url') %>"
                  placeholder="mapbox://styles/…"
                  hint="A style of your own. Overrides the base style above whenever it's set.">
        </wa-input>
      </div>
    </wa-details>
  <% end %>

  <div class="map-editor__preview">
    <%# The preview is also the control that opens the zoom dialog. The image in that dialog uses
        the *same* URL, thus it needs no second Mapbox render: the browser already has that
        response in its cache, at the same 2x size as the download. %>
    <wa-button class="map-editor__zoom" appearance="plain" data-dialog="open map-preview-full">
      <img class="map-editor__image" data-map-preview-target="image"
           src="<%= @track.preview_path %>" alt="Map of <%= @track.title %>">
      <span class="wa-visually-hidden">View at full size</span>
    </wa-button>

    <wa-button data-map-preview-target="download" href="<%= @track.download_path %>" download
               variant="brand" appearance="accent">
      <%= slotted_icon_svg("classic", "light", "arrow-down-to-bracket") %>
      Download PNG
    </wa-button>
  </div>

  <%# This is in the element of the map-preview controller, thus that controller changes this image
      with the image in the page when a setting changes. %>
  <wa-dialog id="map-preview-full" class="map-zoom" label="<%= @track.title %>" data-controller="dialog">
    <img class="map-zoom__image" data-map-preview-target="image"
         src="<%= @track.preview_path %>" alt="Map of <%= @track.title %>">
  </wa-dialog>
</div>
