<% content_for :title, "Location" %>

<h1 class="admin-main__title">Location</h1>

<% unless @location.configured? %>
  <wa-callout variant="warning" class="location__notice">
    <%= slotted_icon_svg("classic", "light", "triangle-exclamation", slot: "icon") %>
    Set <code>MAPBOX_ACCESS_TOKEN</code> in the environment to show the map.
  </wa-callout>
<% end %>

<% if @location.overridden? %>
  <wa-callout variant="warning" class="location__notice">
    <%= slotted_icon_svg("classic", "light", "triangle-exclamation", slot: "icon") %>
    <code>LOCATION</code> is set to <%= @location.override_summary %> in the environment, and
    outranks anything set here. Unset it to use this page.
  </wa-callout>
<% end %>

<%# There are three ways to set a location: an address, a race, or the pin. All three only **stage**
    a location. Save is the one control that writes, and it stays off until the staged location is
    different from the stored one. %>
<div class="location" data-controller="location-map"
     data-location-map-token-value="<%= @location.map_token %>"
     data-location-map-style-value="<%= @location.map_style %>"
     data-location-map-latitude-value="<%= @location.latitude %>"
     data-location-map-longitude-value="<%= @location.longitude %>"
     data-location-map-center-value="<%= @location.center.to_json %>"
     data-location-map-zoom-value="<%= @location.zoom %>"
     data-location-map-save-url-value="<%= @location.save_path %>"
     data-location-map-lookup-url-value="<%= @location.lookup_path %>">

  <div class="location__controls">
    <div class="location__summary">
      <%# The name that the weather widget would show for these coordinates. This page is a preview
          of that name, thus the code makes it again at each new staged location and it does not
          become old. The status line below says if the app stored that location. %>
      <h2 class="location__place wa-heading-l" data-location-map-target="place"><%= @location.heading %></h2>
      <%# The badge is the answer of the page to "did the app store this?". Thus it is with the
          coordinates, and not in the label of the button. `aria-live` is on the line and not on the
          badge, because the two together are the message. %>
      <p class="location__status wa-caption-s" aria-live="polite">
        <wa-badge class="location__state" variant="<%= @location.state_variant %>" appearance="outlined"
                  data-location-map-target="state"><%= @location.state_label %></wa-badge>
        <span data-location-map-target="status"><%= @location.details %></span>
      </p>

      <%# Both are off at the first render, and that is correct: nothing is staged, thus there is
          nothing to write and nothing to remove. The controller sets both on when the staged
          location becomes different from the stored one, and it sets them off again after a
          successful save, and after Undo puts the pin back. Each label is one word, thus neither
          one looks like the larger action. %>
      <div class="location__actions">
        <wa-button class="location__save" variant="brand" appearance="accent" disabled
                   data-location-map-target="save" data-action="click->location-map#save">
          <%= slotted_icon_svg("classic", "light", "floppy-disk") %>
          Save
        </wa-button>

        <wa-button appearance="outlined" disabled
                   data-location-map-target="undo" data-action="click->location-map#undo">
          <%= slotted_icon_svg("classic", "light", "arrow-rotate-left") %>
          Undo
        </wa-button>
      </div>
    </div>

    <wa-divider></wa-divider>

    <%# This is a true <form>, thus Enter in the field submits it. But it never reaches the network by
        itself: the controller stops the submit and posts the address to the same action that a pin
        uses. There is no path with no JavaScript to keep, because without JavaScript this page has
        no map. %>
    <form class="location__search" data-action="submit->location-map#search">
      <wa-input name="address" label="Address" placeholder="An address, or the name of a place"
                autocomplete="off" enterkeyhint="go" data-location-map-target="address">
      </wa-input>

      <%# This is outlined and not accent: it stages a location, as each other control here does,
          and the one accent button on the page must be the button that writes. %>
      <wa-button class="location__go" type="submit" appearance="outlined">
        <%= slotted_icon_svg("classic", "light", "magnifying-glass") %>
        Go there
      </wa-button>
    </form>

    <% if @location.races.any? %>
      <%# This is in the condition: with no race ahead, there are no two parts to separate. %>
      <wa-divider></wa-divider>

      <section class="location__races" aria-labelledby="hed-races">
        <h2 class="location__races-heading wa-heading-s" id="hed-races">Upcoming races</h2>

        <%# The coordinates are on the button, and the code does not make them again: they come from
            Contentful, thus a shortcut puts the pin at the exact place that the race card gives. %>
        <ul class="plain-list wa-stack wa-gap-2xs">
          <% @location.races.each do |race| %>
            <li>
              <wa-button class="location__race" appearance="outlined"
                         data-action="click->location-map#useRace"
                         data-latitude="<%= race.latitude %>"
                         data-longitude="<%= race.longitude %>">
                <span class="location__race-title"><%= race.title %></span>
                <span class="location__race-detail">
                  <%= race.on %><% if race.place.present? %> · <%= race.place %><% end %>
                </span>
              </wa-button>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>

  <%# The parent element is the sticky one, and it must be. ⚠️ Mapbox GL JS adds `mapboxgl-map` to
      the element below and loads its stylesheet at run time, *after* ours. Thus its
      `.mapboxgl-map { position: relative }` wins over a `position: sticky` with the same
      specificity, because of the order. Our `top` then becomes a plain relative offset that moves
      the map down. %>
  <div class="location__view">
    <%# This is empty, on purpose. Mapbox GL JS fills it, and that includes the Geolocation button.
        The code removes each element in it with the map, before Turbo caches the page. %>
    <div class="location__map" data-location-map-target="map"></div>
  </div>
</div>
