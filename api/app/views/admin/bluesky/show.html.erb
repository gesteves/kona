<% content_for :title, t("admin.networks.bluesky") %>

<p class="connected-app__back"><%= link_to t("admin.back_to_connected_apps"), connected_apps_path %></p>

<h1 class="admin-main__title"><%= t("admin.networks.bluesky") %></h1>

<p class="connected-app__description">
  <%= t(".description") %>
</p>

<%= form_with url: bluesky_connection_path, method: :post, class: "wa-stack wa-gap-l" do %>
  <wa-input name="handle" label="<%= t(".handle") %>" value="<%= @handle %>" autocomplete="off"
            placeholder="<%= t(".handle_placeholder") %>" required>
  </wa-input>

  <%# ⚠️ The page never renders the stored password into the field. It only says if a password %>
  <%# exists. %>
  <wa-input type="password" name="app_password" label="<%= t(".password") %>" autocomplete="off"
            password-toggle required
            hint="<%= @stored ? t(".password_hint") : t(".password_placeholder") %>">
  </wa-input>

  <div class="wa-cluster wa-gap-s">
    <wa-button type="submit" variant="brand" appearance="accent"><%= t(".connect") %></wa-button>
  </div>
<% end %>
