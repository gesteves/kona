<%= render "layouts/page_header", title: t("admin.networks.mastodon"),
                                  back: [t("admin.back_to_connected_apps"), connected_apps_path],
                                  lead: t(".description") %>

<%# ⚠️ `turbo: false` is necessary. This form gives a redirect to the instance, which is another
    origin, and Turbo Drive cannot follow one. %>
<%= form_with url: mastodon_connection_path, method: :post, class: "wa-stack wa-gap-l", data: { turbo: false } do %>
  <wa-input name="instance" label="<%= t(".instance") %>" value="<%= @instance %>" autocomplete="off"
            placeholder="<%= t(".instance_placeholder") %>" required
            hint="<%= @handle.present? ? t(".connected_hint", handle: @handle) : t(".instance_hint") %>">
  </wa-input>

  <div class="wa-cluster wa-gap-s">
    <wa-button type="submit" variant="brand" appearance="accent">
      <%= slotted_icon_svg("classic", "light", "link") %>
      <%= t(".connect") %>
    </wa-button>
  </div>
<% end %>
