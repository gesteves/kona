# The environment of the specs. dotenv reads this file before .env, thus each value here wins.
#
# The specs use MockRedis for `$redis` (spec/support/mock_redis.rb) and need no Redis server. This
# value is a safety net. A client that the mock misses then uses database 1, and it does not touch
# the credentials of the admin in database 0.
REDIS_URL=redis://localhost:6379/1
