{
  // The types of the Worker test suite (test/**). `npm run check` also runs tsc on this file,
  // thus it is a gate. vitest transpiles the tests with esbuild and never reads this file.
  //
  // This file is separate from tsconfig.json, because the tests need @cloudflare/workers-types,
  // and its Worker globals conflict with the declarations in src/env.d.ts. Thus this file loads
  // those types and does not include src/env.d.ts, and the two never share a compile.
  //
  // ⚠️ `types` names @cloudflare/workers-types directly, and not the pool package. The root type
  // entry of the pool declares no Worker global, thus that name gives "Cannot find name
  // 'ExecutionContext'" in the full suite. No test imports `cloudflare:test`, thus its `/types`
  // subpath is not here.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types/experimental"],
    // This removes the `dom` lib that the file inherits. workers-types and lib.dom both declare
    // `CacheStorage`, and the DOM declaration, which has no `caches.default`, wins. With `dom`,
    // each `caches.default` in the suite is a type error.
    "lib": ["es2022"]
  },
  // src/assets.d.ts is here, and src/env.d.ts is NOT. tsc follows the import of src/og.ts in
  // test/og.test.ts to the binary-module imports of og-render.ts, which need those declarations.
  // The Worker globals of env.d.ts are what conflict with @cloudflare/workers-types.
  "include": ["test/**/*.ts", "vitest.config.mts", "src/assets.d.ts"]
}
