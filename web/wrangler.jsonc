// The Cloudflare Worker that serves the static build and the dynamic routes: the kona-api proxy
// for the widgets and the contact POST, the Plausible proxy, and the Open Graph cards. Refer to
// the root CLAUDE.md.
//
// ⚠️ This file holds no host name, and no other file in the repo holds one. The custom domain is
// in the dashboard (Workers & Pages → this Worker → Settings → Domains & Routes). Each value of
// an environment is a var or a secret in the dashboard:
//
//   Secrets: API_TOKEN (the same as the API_TOKEN of api/, or each widget gets a 401)
//   Vars:    KONA_API_URL (the fly.io origin of the api), PLAUSIBLE_SCRIPT_URL
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kona-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    // The directory_indexes of Middleman makes each page as /about/index.html, for the URL /about/.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // ⚠️ ONLY the paths in this list start the Worker. The static asset layer serves each other
    // path: each HTML page, each asset, the feeds, /.well-known/*, and each 404.
    //
    // ⚠️ Do not use `/*` with one negation for each kind of asset. A wide negation such as
    // `!/*.js` also stops the Worker for /pa/script.js, and nothing reports it.
    //
    // No route in this list has a static asset, thus the asset layer would answer each one with a
    // 404. ⚠️ src/routes.ts holds the same list for the code, and
    // test/browser/worker_routes.test.js compares the two:
    //   /widgets/*, /api/contact  → the kona-api proxy
    //   /pa/*                     → the Plausible proxy
    //   /og.png, /*/og.png        → the Open Graph card renderer (src/og.ts)
    //
    // The card of a page is at the path of that page (/2026/06/26/post/og.png). Thus the cards
    // need two rules: /og.png for the home page, and /*/og.png for each other page. wrangler
    // changes each `*` into `.*` and puts an anchor at each end. Thus `/*/og.png` matches a path
    // of each depth, and `/og.png` alone does not match a card below a directory.
    //
    // ⚠️ Keep the ".png". The Cache Rule of the zone applies only to a path with no ".", thus the
    // extension keeps the cards off the HTML edge TTL of one year, which ignores Cache-Control. A
    // path with no extension (/og, /og/*) needs an exclusion in that rule first, in the dashboard.
    // Refer to docs/cloudflare.md.
    //
    // No /cdn-cgi/* entry is necessary: Cloudflare answers the image transformations at its edge.
    "run_worker_first": [
      "/widgets/*",
      "/api/contact",
      "/pa/*",
      "/og.png",
      "/*/og.png",
    ],
  },

  // The binary modules that src/og-render.ts imports: the font and the logo of the card. wrangler
  // uploads them with the entry point and gives each one to the Worker as an ArrayBuffer.
  //
  // ⚠️ Keep the globs at `**/*`. wrangler matches a glob against the IMPORT SPECIFIER
  // (`./assets/logo.png`), and not against the file path. Thus "src/assets/*.png" matches
  // nothing, and the build fails with "No loader is configured for .png files".
  //
  // ⚠️ Keep `fallthrough`. Without it, wrangler removes its own default Data rule (`**/*.bin`),
  // and a later .bin import makes the build fail.
  //
  // A .wasm rule is not necessary: `{ type: "CompiledWasm", globs: ["**/*.wasm"] }` is a default
  // of wrangler, and the wasm imports of satori and resvg use it.
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf", "**/*.png"], "fallthrough": true },
  ],

  // Workers Logs. The setting is in this file for the same reason as keep_vars below: a deploy
  // applies this file, thus a setting that is only in the dashboard can change at a deploy with
  // no message.
  //
  // invocation_logs gives one `cf-worker-event` record for each request: the method, the URL, the
  // status, the outcome, the CPU time, the wall time, the request headers, and the `cf` object.
  // Thus the routes write almost no log of their own: a `console.*` line is a SECOND record for
  // the same requestId. A route writes a log only for what the platform cannot see, which is the
  // cause of a failure that the response hides. Refer to the console.error calls in api-proxy.ts
  // (the empty 502) and in plausible.ts (the fallback 200 or 202).
  //
  // head_sampling_rate stays at its default of 1 (100%). The Worker runs only on the
  // run_worker_first routes, thus the volume is much below the logs that the plan includes, and a
  // sample would hide the rare events that are important.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },

  // No workers.dev route: it would be an origin that the WAF of the zone does not protect. The
  // Preview URLs use the same value by default, thus they are also off. A test of a deploy uses a
  // host name from the dashboard.
  "workers_dev": false,

  // ⚠️ Keep this. The vars of this Worker hold a host name, thus they are in the dashboard and
  // not in this file. Without keep_vars, a deploy DELETES each var that is absent from this file,
  // thus the next `wrangler deploy` removes KONA_API_URL and PLAUSIBLE_SCRIPT_URL with no message.
  // A deploy never changes a secret.
  "keep_vars": true,
}
