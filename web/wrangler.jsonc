// Cloudflare Worker serving the static build plus the dynamic routes (kona-api proxy for
// widgets + the contact-form POST, Plausible proxy). One Worker replaces Netlify's hosting,
// functions, and edge functions — see the migration plan and root CLAUDE.md.
//
// ⚠️ No hostnames live in this file (or anywhere in the repo). The custom domain is
// attached in the dashboard (Workers & Pages → this Worker → Settings → Domains & Routes),
// and all environment-specific values are dashboard vars/secrets:
//
//   Secrets: API_TOKEN (must match the api/ app's API_TOKEN or every widget 401s)
//   Vars:    KONA_API_URL (the fly.io api origin), PLAUSIBLE_SCRIPT_URL
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kona-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    // Middleman's directory_indexes builds pretty URLs (/about/ → /about/index.html).
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // ⚠️ POSITIVE ALLOWLIST — ONLY these paths invoke the Worker. Everything else (every HTML
    // page, every fingerprinted asset, the sitemap, /.well-known/*, and any 404) is served
    // straight from the static asset layer and never runs Worker code. Requires wrangler ≥ 4.20;
    // globs cross `/`.
    //
    // We flipped from the old "/* minus ~25 asset negations" model once the page-serving
    // fallthrough stopped doing any per-view work: server-side Known Agents tracking was removed,
    // so running the Worker on every page view only cost an invocation + a log line. Page views
    // now skip the Worker entirely. This form also retires the extension-negation traps the old
    // model kept tripping on (a blanket `!/*.js` used to swallow /pa/script.js; `!/*.xml` would
    // swallow the feeds) — there are simply no negations any more.
    //
    // The four dynamic routes that MUST run the Worker (see src/index.ts). Each either has no
    // asset (so assets-first would 404 it) or has an asset the Worker must intercept:
    //   /widgets/*, /api/contact  → kona-api proxy (no asset; must reach the origin)
    //   /pa/*                     → Plausible first-party proxy (no asset; proxied upstream)
    //   /feed.xml, /*/feed.xml    → the built feed IS an asset, but feed-source.ts must relabel
    //                               utm_source per reader — the root feed plus every nested tag
    //                               feed (`<tag path>/feed.xml`, any depth; `*` crosses `/`).
    // No /cdn-cgi/* entry is needed: Cloudflare answers image transformations at its own edge.
    "run_worker_first": [
      "/widgets/*",
      "/api/contact",
      "/pa/*",
      "/feed.xml",
      "/*/feed.xml",
    ],
  },

  // No workers.dev route: it would be an origin that bypasses the zone's WAF. Preview URLs
  // follow this setting (they default to matching workers_dev), so they're off too — testing
  // happens on a dashboard-attached hostname, not on workers.dev.
  "workers_dev": false,

  // ⚠️ Load-bearing. The vars this Worker reads carry a hostname, so they can't live in this
  // file — they're set in the dashboard. A deploy normally DELETES all vars absent from the
  // config (secrets are never touched), which would silently strip KONA_API_URL and
  // PLAUSIBLE_SCRIPT_URL on the next `wrangler deploy`. This keeps them.
  "keep_vars": true,
}
