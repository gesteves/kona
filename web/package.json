{
  "scripts": {
    "build": "esbuild source/javascripts/stimulus/index.js --bundle --minify --target=es2020 --outfile=tmp/dist/javascripts/site.js",
    "watch": "esbuild source/javascripts/stimulus/index.js --bundle --target=es2020 --outfile=tmp/dist/javascripts/site.js --watch=forever",
    "lint:scss": "stylelint \"source/stylesheets/**/*.scss\"",
    "lint:scss:fix": "stylelint \"source/stylesheets/**/*.scss\" --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pagefind": "pagefind --site build"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.23",
    "@web.awesome.me/webawesome-pro": "^3.7.0",
    "esbuild": "^0.28.1",
    "pagefind": "^1.5.2",
    "wrangler": "^4.115.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@cloudflare/workers-types": "^5.20260729.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
