{
  "scripts": {
    "build": "esbuild source/javascripts/stimulus/index.js --bundle --minify --target=es2020 --outfile=tmp/dist/javascripts/site.js",
    "watch": "esbuild source/javascripts/stimulus/index.js --bundle --target=es2020 --outfile=tmp/dist/javascripts/site.js --watch=forever",
    "lint:scss": "stylelint \"source/stylesheets/**/*.scss\"",
    "lint:scss:fix": "stylelint \"source/stylesheets/**/*.scss\" --fix",
    "lint:js": "eslint source/javascripts test/browser",
    "lint:js:fix": "eslint source/javascripts test/browser --fix",
    "format": "prettier --write \"**/*.{js,ts,mts,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,mts,json,md}\"",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pagefind": "pagefind --site build"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.23",
    "@resvg/resvg-wasm": "^2.6.2",
    "@web.awesome.me/webawesome-pro": "^3.11.0",
    "esbuild": "^0.28.2",
    "pagefind": "^1.5.2",
    "satori": "^0.29.1",
    "wrangler": "^4.124.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260812.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
