{
  // This file only checks the types of the Cloudflare Worker in src/. wrangler makes the bundle
  // with esbuild and checks no type, thus `npm run check` (tsc --noEmit) is the type gate.
  //
  // @cloudflare/workers-types is NOT here, on purpose. src/env.d.ts declares the Worker globals
  // that the code needs (Env, Fetcher, ExecutionContext, caches.default, HTMLRewriter), and the
  // code uses the standard lib.dom types. workers-types conflicts with those declarations: for
  // example, its ExecutionContext#waitUntil is different. `types: []` keeps each ambient @types
  // package out.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
