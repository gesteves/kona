.bundle
.cache
.DS_Store
.sass-cache
build/
.env
# Everything under data/ is generated by `rake import`, except the two checked-in inputs. Broader
# than `data/*.json`, which reached only one level and only .json, so a generated PNG (or anything
# in a subdirectory) would get committed — `/data/*` still covers those, since an ignored
# subdirectory is never descended into.
#
# ⚠️ Both halves of `/data/*` are load-bearing. The leading slash anchors it here: unanchored,
# `data/` matches a directory of that name at ANY depth, which also swallowed lib/data/ and
# spec/lib/data/ — both real source. And the `*` ignores the directory's *contents* rather than
# the directory, which is what lets the two negations below work at all; git never descends into
# an excluded directory, so under a bare `/data/` they were silently dead letters.
/data/*
!/data/font_awesome.yml
!/data/srcsets.yml

# `rake import:schema` writes the Contentful schema here, thus `rake test` needs no network after
# one import. With no file, the data layer reads the live schema.
/lib/data/graphql/contentful_schema.json
node_modules

# Local Wrangler state (created by `wrangler dev`)
.wrangler
tmp/
prompts/

.agents/skills/
