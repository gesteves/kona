# The headers for the static build, in the `_headers` format of Cloudflare Workers Static Assets.
# The build makes this file as source/headers, and lib/tasks/build.rake renames it, because a
# source file with an underscore at the start is a partial.
#
# ⚠️ When more than one rule matches a path, Cloudflare joins the headers with the same name with a
# comma. The more specific rule does not win. Thus no two rules here can set the same header for
# paths that overlap. For that reason the cache policy lists the paths and does not use a /*
# catch-all: a catch-all Cache-Control would break the rules for the fingerprinted assets.

# ⚠️ The security headers apply ONLY to an asset-layer response. Each path in the run_worker_first
# list of wrangler.jsonc — /widgets/*, /api/contact, /pa/*, and the two OG card globs — does not
# use this file and must set the headers itself. They all do that through withSecurityHeaders in
# src/headers.ts. Keep that function the same as the /* block below.
/*
  Referrer-Policy: no-referrer-when-downgrade
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  # ⚠️ Set this here and NOT in the dashboard (SSL/TLS -> Edge Certificates -> HSTS). With both,
  # Cloudflare joins the two values into one header with a comma. The api host gets its own HSTS
  # from the Rails `force_ssl` (api/config/environments/production.rb), thus www is the only host
  # that needs this. Do not add `preload`: you cannot remove a host from the preload list.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # This is Report-Only, on purpose. The article bodies come from Contentful, thus a post can add
  # a new embed host. The frame-src below comes from the hosts in the build TODAY: YouTube, Apple
  # Podcasts, and Spotify. A policy that stops a load would break such a post with no message. Each
  # violation appears in the browser console. Change this to `Content-Security-Policy` after you
  # read the pages with many embeds and the console is clean. Also read frame-src again each time
  # someone uses a new type of embed.
  # 'unsafe-inline' in script-src is necessary: the JSON-LD blocks (partials/schema/*) and the
  # Plausible init code (partials/_analytics.html.erb) are inline. style-src needs it for the
  # shadow-DOM styles of Web Awesome and for the inline style attributes on the embed iframes.
  # ⚠️ img-src names IMAGES_URL, the host that Cloudflare Images serves each transformation from.
  # Each image on the site is a transformation. It named *.ctfassets.net, which is old, because the
  # app now copies each asset to R2, and which is the one host that the zone must never accept as
  # an image source. The mirror host is absent, on purpose: Cloudflare gets it on the server and
  # the browser never does. connect-src has Turnstile, which sends an XHR to
  # challenges.cloudflare.com.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: <%= ENV['IMAGES_URL'] %>; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://www.youtube-nocookie.com https://embed.podcasts.apple.com https://open.spotify.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/.well-known/site.standard.publication
  Content-Type: text/plain; charset=utf-8

# asset_hash (config.rb) puts a fingerprint in each of these names. New content gives a new URL,
# thus a cached copy is never old and the cache can keep it for all time.
/javascripts/*
  Cache-Control: public, max-age=31536000, immutable

/stylesheets/*
  Cache-Control: public, max-age=31536000, immutable

# These URLs stay the same but their content changes at each build. Their extensions are in the
# default edge cache of Cloudflare (.xml, .json, .txt, .png, .ico). Store them, but always check
# them against the ETag. A deploy does NOT invalidate the edge by itself: Cloudflare serves its
# cached copy (cf-cache-status: HIT) and does not check it against the new asset. Thus another
# process does the invalidation: a Cloudflare Cache Response Rule gives each response the tag
# `site`, and .github/workflows/web.yml purges that tag at each deploy.
# HTML with no extension needs no rule here. It is not in the default-cache extension list of
# Cloudflare, and max-age=0 with must-revalidate is already its default. The tag purge also covers
# it.
/feed.xml
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=0, must-revalidate

/llms.txt
  Cache-Control: public, max-age=0, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=0, must-revalidate

# The Pagefind search index and its component UI. `npm run pagefind` makes all of them again at
# each build. The file names at the top level have no hash, thus `immutable` would keep an old
# index. The chunks in index/ and fragment/ DO have a content hash and could be immutable, but a
# glob here goes past a `/`. Thus a second, more specific rule would overlap this one and
# Cloudflare would join the two Cache-Control values with a comma. Use one rule for the full
# tree.
/pagefind/*
  Cache-Control: public, max-age=0, must-revalidate

# The Atom feed of each tag is at /tagged/**/feed.xml. This also matches the tag archive HTML
# pages, which causes no problem: this directive is the default for those pages.
/tagged/*
  Cache-Control: public, max-age=0, must-revalidate
