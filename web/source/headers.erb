# Headers for the static build, in the Cloudflare Workers Static Assets `_headers` format
# (built as source/headers and renamed by lib/tasks/build.rake, since underscore-prefixed
# source files are treated as partials).
#
# ⚠️ When multiple rules match a path, Cloudflare comma-joins same-name headers rather than
# letting the more specific rule win — so no two rules here may set the same header for
# overlapping paths. That's why the cache policy enumerates paths instead of using a
# /* catch-all: a catch-all Cache-Control would corrupt the fingerprinted-asset rules.

# ⚠️ Security headers apply ONLY to asset-layer responses. The two Worker routes
# (/widgets/*, /api/contact — see wrangler.jsonc's run_worker_first) rebuild their response
# headers from scratch in src/api-proxy.ts and set their own copies there.
/*
  Referrer-Policy: no-referrer-when-downgrade
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  # ⚠️ Set here and NOT in the dashboard (SSL/TLS -> Edge Certificates -> HSTS). Enabling both
  # comma-joins two values into one header. The api host gets its own HSTS from Rails
  # `force_ssl` (api/config/environments/production.rb), so www is the only gap this fills.
  # No `preload` — submitting to the preload list is effectively irreversible.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Report-Only on purpose: article bodies come from Contentful, so a post can introduce a new
  # embed host (frame-src below was derived from what's in the build TODAY: YouTube, Apple
  # Podcasts, Spotify) and an enforcing policy would silently break it. Violations surface in the
  # browser console. Promote to `Content-Security-Policy` once you've browsed the embed-heavy
  # pages and the console is clean — and re-check frame-src whenever a new embed type is used.
  # 'unsafe-inline' in script-src is load-bearing: the JSON-LD blocks (partials/schema/*) and the
  # Plausible init snippet (partials/_analytics.html.erb) are inline. style-src needs it for Web
  # Awesome's shadow-DOM styles and the inline style attrs on embed iframes.
  # ⚠️ img-src names IMAGES_URL, the host Cloudflare Images serves transformations from — every
  # image on the site is one. It listed *.ctfassets.net instead, which is both stale (assets are
  # mirrored to R2 now) and the one host the zone must never treat as an image source. The mirror
  # host itself is absent on purpose: Cloudflare fetches it server-side, the browser never does.
  # connect-src carries Turnstile, which XHRs to challenges.cloudflare.com.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: <%= ENV['IMAGES_URL'] %>; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://www.youtube-nocookie.com https://embed.podcasts.apple.com https://open.spotify.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/.well-known/site.standard.publication
  Content-Type: text/plain; charset=utf-8

# Fingerprinted by asset_hash (config.rb): new content = new URL, so these can never go
# stale and are safe to cache forever.
/javascripts/*
  Cache-Control: public, max-age=31536000, immutable

/stylesheets/*
  Cache-Control: public, max-age=31536000, immutable

# Stable URLs whose content changes every build, with extensions Cloudflare's default
# edge cache picks up (.xml, .json, .txt, .png, .ico). Store, but always revalidate
# against the ETag. Deploys do NOT self-invalidate at the edge — Cloudflare serves its
# cached copy (cf-cache-status: HIT) rather than revalidating against the freshly deployed
# asset — so invalidation is handled out of band: a Cloudflare Cache Response Rule tags
# responses `site` and .github/workflows/web.yml purges that tag on every deploy.
# (Extensionless HTML needs no rule here: it isn't in Cloudflare's default-cache extension
# list, and max-age=0 + must-revalidate is already the default for it — the tag purge
# covers it too.)
/feed.xml
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=0, must-revalidate

/llms.txt
  Cache-Control: public, max-age=0, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=0, must-revalidate

# The Pagefind search index and its component UI, regenerated wholesale by `npm run
# pagefind` on every build. The top-level filenames are unhashed, so `immutable` would
# pin a stale index. (The nested index/ and fragment/ chunks ARE content-hashed and could
# be immutable, but globs cross `/` here — a second, more specific rule would overlap this
# one and Cloudflare would comma-join the two Cache-Controls. One rule for the tree.)
/pagefind/*
  Cache-Control: public, max-age=0, must-revalidate

# The per-tag Atom feeds live at /tagged/**/feed.xml. This also matches the tag archive
# HTML pages, which is harmless: this directive is exactly the default they'd get anyway.
/tagged/*
  Cache-Control: public, max-age=0, must-revalidate
