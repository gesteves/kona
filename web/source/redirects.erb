<%#
  ⚠️ RULE ORDER IS LOAD-BEARING — statics must be emitted before dynamics, or the deploy fails
  with a bare `code: 100324` once the file passes ~100 lines. The rules, the two validity filters,
  and the partition live in SiteHelpers#partitioned_redirects, which carries the full reasoning
  and is covered by spec/lib/helpers/site_helpers_spec.rb. This template only emits them.
%>
<% static_rules, dynamic_rules = partitioned_redirects %>
<%# Static (exact-match) redirects — counted against Cloudflare's 2,000-rule limit. %>
<% static_rules.each do |r| %>
<%= r[:from] %> <%= r[:to] %> <%= r[:status] %>
<% end %>
<%# Dynamic (splat/placeholder) redirects — counted against the 100-rule limit. Emitted last. %>
<% dynamic_rules.each do |r| %>
<%= r[:from] %> <%= r[:to] %> <%= r[:status] %>
<% end %>
