<%#
  ⚠️ THE ORDER OF THE RULES IS IMPORTANT. The static rules must come before the dynamic rules, or
  the deploy fails. RedirectHelpers#partitioned_redirects has the rules and the reason, and
  spec/lib/helpers/redirect_helpers_spec.rb tests it. This template only writes them.
%>
<% static_rules, dynamic_rules = partitioned_redirects %>
<%# The static redirects, which match exactly. Cloudflare permits 2,000 of them. %>
<% static_rules.each do |r| %>
<%= r[:from] %> <%= r[:to] %> <%= r[:status] %>
<% end %>
<%# The dynamic redirects, which have a splat or a placeholder. Cloudflare permits 100 of them,
    and they come last. %>
<% dynamic_rules.each do |r| %>
<%= r[:from] %> <%= r[:to] %> <%= r[:status] %>
<% end %>
