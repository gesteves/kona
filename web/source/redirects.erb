<%# Plausible analytics first-party proxy (/pa/*). Emitted first so a catch-all %>
<%# redirect from Contentful (below) can't shadow these rewrites. See site_helpers.rb. %>
<% plausible_proxy_redirects.each do |redirect| %>
<%= redirect[:from] %> <%= redirect[:to] %> <%= redirect[:status] %>
<% end %>
<%# Bridgy Fed (fediverse) discovery endpoints, moved here from the root netlify.toml %>
<%# so the generated _redirects file is the single source for every redirect rule. %>
/.well-known/host-meta* https://fed.brid.gy/.well-known/host-meta:splat 302
/.well-known/webfinger* https://fed.brid.gy/.well-known/webfinger 302
<% taxonomy_synonym_redirects.each do |redirect| %>
<%= redirect[:from] %> <%= redirect[:to] %> <%= redirect[:status] %>
<% end %>
<% data.redirects.each do |redirect| %>
<%= redirect.from %> <%= redirect.to %> <%= redirect.status %><%= "!" if redirect.from.match? /^https?:\/\// %>
<% end %>
