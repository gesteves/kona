<div class="blog">
  <%# The blog index shows no visible heading, and a tag page is different. But each page needs %>
  <%# its subject as its one <h1>, thus this heading is for a screen reader only. %>
  <h1 class="sr-only" id="hed"><%= heading_text(content.title) %></h1>
  <%= partial 'partials/blog_list', locals: { content: content } %>
</div>
