<div class="blog">
  <%# The blog index shows no visible headline (unlike tag pages), but every page needs %>
  <%# its subject as the sole <h1>, so it's screen-reader-only here. %>
  <h1 class="sr-only" id="hed"><%= smartypants(content.title) %></h1>
  <%= partial 'partials/blog_list', locals: { content: content } %>
</div>
