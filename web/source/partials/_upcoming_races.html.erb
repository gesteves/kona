<%# Loading skeleton for the races widget. The wrapper carries the live-update attributes; %>
<%# it's display:contents, so the section lays out directly in the page grid. The API swaps %>
<%# the whole wrapper in on connect — a single "Upcoming Races" section, or a "Today's Race" %>
<%# + "Upcoming Races" pair on race day — and removes it on an empty response (no upcoming %>
<%# races). See api/app/views/widgets/events/. `url` (required local) is the API endpoint. %>
<div class="collection-group" data-nosnippet <%= live_update_attrs(url) %>>
  <%# The api picks this modifier from the race count (and adds collection--has-featured, or a %>
  <%# second "Today's Race" section on race day), so only the wrapper above is a fixed shape. %>
  <%# --thirds/3 items is the common case; the grid reflows on the others. %>
  <section class="collection collection--thirds" id="upcoming-races" aria-labelledby="hed-upcoming-races">
    <h2 class="collection__heading" id="hed-upcoming-races">Upcoming Races</h2>
    <ol class="collection__list">
      <% 3.times do %>
        <li class="collection__item">
          <%= partial 'partials/placeholders/entry_skeleton', locals: { lines: 4 } %>
        </li>
      <% end %>
    </ol>
  </section>
</div>
