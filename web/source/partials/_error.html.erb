<%#
  The body shared by every Cloudflare Custom Error Page (source/errors/, layouts/error.erb).
  Same shape as source/404.html.erb minus the recent-articles module, which needs the JS
  bundle for its relative timestamps and would go stale the moment Cloudflare stores the page.

  Two optional frontmatter knobs, both of them Cloudflare error tokens rendered raw and
  unescaped — keep them verbatim, and don't run either through smartypants or markdown:

  - `token`: the page-type-specific token (`::CLOUDFLARE_ERROR_500S_BOX::`, `::CAPTCHA_BOX::`,
    …). Cloudflare substitutes it for the box carrying the error detail — or, on the challenge
    pages, for the challenge widget itself, without which the visitor cannot pass. Required on
    the page types that document one; omitting it there breaks the page.
  - `details`: renders the three tokens that work on any error page (`::RAY_ID::`,
    `::CLIENT_IP::`, `::GEO::`). Used on the block pages, which have no required token of
    their own but do need to give the visitor something to quote when a block is a false
    positive.
%>
<div class="home" aria-labelledby="hed">
  <section class="home__intro">
    <h1 class="home__headline" id="hed">
      <%= smartypants(current_page.data.title) %>
    </h1>
    <div class="home__body">
      <%= smartypants(markdown_to_html(current_page.data.body)) %>
    </div>
    <% if current_page.data.token.present? || current_page.data.details %>
      <div class="home__body">
        <% if current_page.data.token.present? %>
          <%= current_page.data.token %>
        <% end %>
        <% if current_page.data.details %>
          <ul>
            <li>Ray ID: <code>::RAY_ID::</code></li>
            <li>Your IP address: <code>::CLIENT_IP::</code></li>
            <li>Country or region: <code>::GEO::</code></li>
          </ul>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
