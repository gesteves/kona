<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <%# max and min are nil for an empty feed, and .rfc3339 and .strftime below would then raise. %>
  <% updated = articles.map { |e| DateTime.parse(e.updated_at) }.max || DateTime.now %>
  <id><%= atom_tag(full_url(html_path), articles.map { |e| published_datetime(e) }.min || updated) %></id>
  <title><%=h title %></title>
  <% if subtitle.present? %><subtitle><%=h subtitle %></subtitle><% end %>
  <updated><%= updated.rfc3339 %></updated>
  <link rel="alternate" type="text/html" href="<%=h full_url(html_path) %>"/>
  <link rel="self" type="application/atom+xml" href="<%=h full_url(feed_path) %>"/>
  <rights>© <%= copyright_years %> <%= data.site.copyright %></rights>
  <% articles.each do |entry| %>
    <entry>
      <% entry_published = published_datetime(entry) %>
      <id><%= atom_tag(full_url(entry.path), entry_published) %></id>
      <title><%=h smartypants(sanitize(entry.title)) %></title>
      <link rel="alternate" type="text/html" href="<%=h full_url(entry.path) %>"/>
      <published><%= entry_published.rfc3339 %></published>
      <updated><%= DateTime.parse(entry.updated_at).rfc3339 %></updated>
      <author>
        <name><%=h entry.author.name %></name>
      </author>
      <%# ⚠️ This uses content_summary, and not entry.summary: a Short has no summary field, and Atom
          needs content in this element. The `sanitize` at the end is also what escapes each entity
          one time only: it decodes to Unicode, thus the smartypants below finds no straight
          quotation mark to change into `&rsquo;`, and `h` then does not escape that a second time.
          The title above uses sanitize first for the same reason. %>
      <summary><%=h smartypants(content_summary(entry)) %></summary>
      <content type="html">
        <%=h render_feed_body(entry.intro) %>
        <%=h render_feed_body(entry.body) %>
        <%=h partial 'partials/disclosure', locals: { entry: entry } %>
      </content>
      <% if entry.contentful_metadata.tags.present? %>
        <% entry.contentful_metadata.tags.sort_by(&:name).each do |tag| %>
          <category term="<%=h tag.name %>" />
        <% end %>
      <% end %>
    </entry>
  <% end %>
</feed>
