<% if items.present? %>
  <nav class="nav" id="nav" data-controller="nav" data-nav-open-class="has-nav-open" data-action="turbo:before-cache@document->nav#closeNav search:close@document->nav#closeNav">
    <ol class="nav__list">
    <% items.each do |i| %>
      <li class="nav__item">
        <%= shortcut_link(i) %>
      </li>
    <% end %>
      <li class="nav__item nav__item--search">
        <button type="button" data-controller="search" data-action="click->search#open">Search</button>
      </li>
    </ol>
    <button id="nav-button" aria-expanded="false" aria-label="Open menu" aria-controls="nav-menu" class="nav__hamburger" data-nav-target="button" data-action="click->nav#toggleNav">
      <span class="nav__hamburger-closed" aria-hidden="true">
        <%= icon_svg "classic", "light", "bars" %>
      </span>
      <span class="nav__hamburger-open" aria-hidden="true">
        <%= icon_svg "classic", "light", "xmark" %>
      </span>
    </button>
  </nav>
<% end %>
