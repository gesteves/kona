<% if meta_title_source %>
  <meta property="og:title" content="<%= h page_title(meta_title_source) %>">
<% end %>

<% if meta_description.present? %>
  <meta property="og:description" content="<%= h meta_description %>">
<% end %>

<%# page_content is the same object that `content` names. It is nil on a page with no content. %>
<% page = page_content %>
<% og_image, og_image_alt = open_graph_image %>
<% if og_image %>
  <meta property="og:image" content="<%= og_image %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <% unless og_image_alt.nil? %>
    <meta property="og:image:alt" content="<%= h og_image_alt %>">
  <% end %>
<% end %>

<meta property="og:url" content="<%= full_url(current_page.url) %>">
<% if blog_post?(page) %>
  <meta property="og:type" content="article">
<% else %>
  <meta property="og:type" content="website">
<% end %>

<% if blog_post?(page) %>
  <% if page.published_at.present? %>
    <meta property="article:published_time" content="<%= published_datetime(page).iso8601 %>">
  <% end %>
  <% if page.updated_at.present? %>
    <meta property="article:modified_time" content="<%= DateTime.parse(page.updated_at).iso8601 %>">
  <% end %>
  <% if page.author&.name.present? %>
    <meta property="article:author" content="<%= h page.author.name %>">
  <% end %>
  <% if page.contentful_metadata&.tags.present? %>
    <% page.contentful_metadata.tags.each do |tag| %>
      <meta property="article:tag" content="<%= h tag.name %>">
    <% end %>
  <% end %>
<% end %>

<meta property="og:site_name" content="<%= h data.site.title %>">
<meta property="og:locale" content="en_US">

<% if page&.author&.mastodon.present? %>
  <meta name="fediverse:creator" content="@<%= h page.author.mastodon.gsub(/^@/, '') %>">
<% end %>
