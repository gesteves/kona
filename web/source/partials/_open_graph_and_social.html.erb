<% if meta_title_source %>
  <meta property="og:title" content="<%= h page_title(meta_title_source) %>">
<% end %>

<% if meta_description.present? %>
  <meta property="og:description" content="<%= h meta_description %>">
<% end %>

<%# Each OG image has the card size of 1200×630. Only the URL and the alt text are different in each
    condition. The alt text can be an empty string, for a cover image with no description. It is nil
    only when a content page has no title, and that is the one condition where the page has no
    og:image:alt tag. %>
<% og_image, og_image_alt = if defined?(content) && content.cover_image.present?
     [open_graph_image_url(content.cover_image.url), content.cover_image.description.to_s]
   elsif defined?(content)
     [generate_open_graph_image_url(current_page.url, content.sys&.published_version), (page_title(meta_title_source) if meta_title_source)]
   elsif data.site.cover_image.present?
     [open_graph_image_url(data.site.cover_image.url), data.site.cover_image.description.to_s]
   end %>
<% if og_image %>
  <meta property="og:image" content="<%= og_image %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <% unless og_image_alt.nil? %>
    <meta property="og:image:alt" content="<%= h og_image_alt %>">
  <% end %>
<% end %>

<meta property="og:url" content="<%= full_url(current_page.url) %>">
<% if defined?(content) && blog_post?(content) %>
  <meta property="og:type" content="article">
<% else %>
  <meta property="og:type" content="website">
<% end %>

<% if defined?(content) && blog_post?(content) %>
  <% if content&.published_at.present? %>
    <meta property="article:published_time" content="<%= published_datetime(content).iso8601 %>">
  <% end %>
  <% if content&.updated_at.present? %>
    <meta property="article:modified_time" content="<%= DateTime.parse(content.updated_at).iso8601 %>">
  <% end %>
  <% if content&.author&.name.present? %>
    <meta property="article:author" content="<%= h content.author.name %>">
  <% end %>
  <% if content&.contentful_metadata&.tags.present? %>
    <% content.contentful_metadata.tags.each do |tag| %>
      <meta property="article:tag" content="<%= h tag.name %>">
    <% end %>
  <% end %>
<% end %>

<meta property="og:site_name" content="<%= h data.site.title %>">
<meta property="og:locale" content="en_US">

<% if defined?(content) && content&.author&.mastodon.present? %>
  <meta name="fediverse:creator" content="@<%= h content.author.mastodon.gsub(/^@/, '') %>">
<% end %>
