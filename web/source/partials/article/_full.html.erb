<article class="entry entry--full entry--article" id="<%= entry_dom_id(article) %>" aria-labelledby="<%= entry_heading_id(article) %>">
  <header class="entry__header">
    <%= partial 'partials/article/meta', locals: { article: article } %>
    <h1 class="entry__hed" id="<%= entry_heading_id(article) %>" data-pagefind-meta="title">
      <%= smartypants(article.title) %>
    </h1>
    <p class="entry__meta">
      <span><%= icon_svg("classic", "light", "stopwatch") %> <%= reading_time(article) %></span>
      <% views_url = "/widgets/plausible/pageviews/#{article.sys.id}" %>
      <span data-controller="live-update" data-live-update-url-value="<%= views_url %>" data-live-update-fetch-on-connect-value="true"><%= icon_svg("classic", "light", "eye") %> <wa-skeleton class="view-count-skeleton" effect="sheen"></wa-skeleton></span>
    </p>
  </header>
  <%= partial 'partials/article/body', locals: { article: article, pagefind: !article.draft } %>
</article>
