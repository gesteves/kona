<article class="entry entry--compact" id="<%= entry_dom_id(article) %>" aria-labelledby="<%= entry_heading_id(article) %>">
  <header class="entry__header">
    <%= partial 'partials/article/meta', locals: { article: article } %>
    <h2 class="entry__hed" id="<%= entry_heading_id(article) %>">
      <%= link_to smartypants(article.title), article.path %>
    </h2>
  </header>
  <div class="entry__body">
    <%= render_body(article.intro) %>
    <%# ⚠️ The title is in the accessible name, visually hidden. The icon is aria-hidden, so
        without it the blog index emits ~40 links all named just "Continue reading" — which is
        what a screen reader's links list shows. %>
    <%= link_to "Continue reading<span class=\"sr-only\">: #{h sanitize(article.title)}</span> #{icon_svg("classic", "light", "arrow-right")}", article.path, class: "entry__read-more" %>
  </div>
</article>
