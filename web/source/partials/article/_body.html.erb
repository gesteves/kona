<%# locals: (article:, tracking_section: nil, **) %>
<%# The full text of an entry: the intro, the body, and the affiliate-link disclosure. The article
    template and the page template share it. `tracking_section` adds the Article Click analytics
    to each link to an article in the text. data-pagefind-body lets the site search index the
    div. Refer to search_indexable?. %>
<div class="entry__body"<%= ' data-pagefind-body'.html_safe if search_indexable?(article) %>>
  <%# first_image marks the FIRST image of the two calls only. Refer to claim_lcp_image.
      ⚠️ :priority, and NOT :eager. The LCP element of an article is text, and its first body
      image is usually below the fold. Thus the image stays lazy, and the mark only raises the
      priority of its fetch. %>
  <%= render_body(article.intro, image_variant: :full, first_image: :priority, tracking_section: tracking_section) %>
  <%= render_body(article.body, image_variant: :full, first_image: :priority, tracking_section: tracking_section) %>
  <%# The contact form is a partial, and it is not raw HTML in the Contentful body. Refer to
      partials/_contact_form for the reason. %>
  <%= partial 'partials/contact_form' if article.slug == 'contact' %>
  <%= partial 'partials/disclosure', locals: { entry: article } %>
</div>
