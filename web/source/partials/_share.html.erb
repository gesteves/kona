<div class="share" id="social-sharing">
  <h2 class="share__heading"><%= share_heading(article) %></h2>

  <wa-scroller class="share__scroller" orientation="horizontal" without-scrollbar>
    <div class="share__buttons">
      <button aria-label="Open sharing options" title="Open sharing options" class="share__button share__hidden" data-controller="share" data-share-text-value="<%= sanitize(article.title) %>" data-share-url-value="<%= full_url(article.path) %>" data-share-is-native-value="true" data-share-via-value="Native" data-action="click->share#openShareSheet" data-share-hidden-class="share__hidden">
        <%= icon_svg("classic", "solid", "arrow-up-from-bracket") %>
      </button>

      <a aria-label="Copy link to clipboard" title="Copy link to clipboard" class="share__button" href="<%= full_url(article.path) %>" data-controller="clipboard" data-clipboard-hidden-class="share__hidden" data-clipboard-success-message-value="A link to this <%= entry_type(article).downcase %> has been copied to your clipboard." data-action="click->clipboard#copy">
        <span data-clipboard-target="link">
          <%= icon_svg("classic", "solid", "link") %>
        </span>
        <span data-clipboard-target="check" class="share__hidden">
          <%= icon_svg("classic", "solid", "check") %>
        </span>
      </a>

      <% share_buttons.each do |button| %>
        <a aria-label="<%= button[:label] %>" title="<%= button[:label] %>" class="share__button" href="<%= share_url(button[:network], article) %>" rel="noopener nofollow"<%= ' target="_blank"'.html_safe if button.fetch(:new_tab, true) %> data-controller="share" data-share-via-value="<%= button[:via] || button[:network] %>" data-action="click->share#<%= button.fetch(:action, 'trackShare') %>">
          <%= icon_svg("classic", *button[:icon]) %>
        </a>
      <% end %>
    </div>
  </wa-scroller>
</div>
