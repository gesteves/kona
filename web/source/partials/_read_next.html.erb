<%# The navigation through the archive in order. It has two halves, and at a larger breakpoint they
    are beside each other: the older entry at the left ("Previous") and the newer entry at the right
    ("Next"). Each one is a summary card with no body, thus the reader can go back or forward
    through the archive. Each half is its own collection, thus each one has its own heading. At an
    end of the archive, only one half renders, and it moves to the center. Refer to
    .collection--adjacent. It renders nothing when the entry has no neighbor, for example a draft
    preview. %>
<% adjacent = adjacent_articles(article) %>
<% older = adjacent[:older] %>
<% newer = adjacent[:newer] %>
<% if older || newer %>
  <nav class="collection-group" aria-label="More entries">
    <%# This uses aria-labelledby for the same reason as partials/_collection: a <section> with no
        name is not a landmark. %>
    <% [ [ "previous", "Previous", older ], [ "next", "Next", newer ] ].each do |id, heading, entry| %>
      <% next unless entry %>
      <section class="collection collection--adjacent" aria-labelledby="hed-<%= id %>-entry">
        <h2 class="collection__heading" id="hed-<%= id %>-entry"><%= heading %></h2>
        <ol class="collection__list">
          <li class="collection__item">
            <%= partial 'partials/article/summary', locals: { article: entry, show_body: false } %>
          </li>
        </ol>
      </section>
    <% end %>
  </nav>
<% end %>
