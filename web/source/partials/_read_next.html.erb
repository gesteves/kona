<%# Sequential archive navigation, split into two halves that sit side by side at the larger
    breakpoints: the chronologically older entry on the left ("Previous") and the newer entry on
    the right ("Next"), each a body-less summary card, so the reader can step backward or
    forward through the archive. Each side is its own collection so it carries its own heading;
    at an end of the archive only one side renders (and centers itself — see .collection--adjacent).
    Renders nothing when the entry has no neighbors (e.g. a draft preview). %>
<% adjacent = adjacent_articles(article) %>
<% older = adjacent[:older] %>
<% newer = adjacent[:newer] %>
<% if older || newer %>
  <nav class="collection-group" aria-label="More entries">
    <%# aria-labelledby for the same reason as partials/_collection: an unnamed <section> isn't
        exposed as a landmark at all. %>
    <% [ [ "previous", "Previous", older ], [ "next", "Next", newer ] ].each do |id, heading, entry| %>
      <% next unless entry %>
      <section class="collection collection--adjacent" aria-labelledby="hed-<%= id %>-entry">
        <h2 class="collection__heading" id="hed-<%= id %>-entry"><%= heading %></h2>
        <ol class="collection__list">
          <li class="collection__item">
            <%= partial 'partials/article/summary', locals: { article: entry, show_body: false } %>
          </li>
        </ol>
      </section>
    <% end %>
  </nav>
<% end %>
