<footer class="footer" id="footer">
  <div class="footer__wrapper">
    <a href="/" class="footer__logo-link" aria-label="<%= data.site.title %>">
      <%= partial 'partials/logo.svg.erb' %>
    </a>

    <% socials = data.site.socials_collection.items.compact %>
    <% if socials.present? %>
      <wa-scroller class="footer__socials" orientation="horizontal" without-scrollbar>
        <ul class="footer__socials-list" role="list">
          <% socials.each do |i| %>
            <li class="footer__social-item"><%= social_media_link(title: i.title, destination: i.destination, css_class: "share__button", open_in_new_tab: i.open_in_new_tab) %></li>
          <% end %>
        </ul>
      </wa-scroller>
    <% end %>

    <hr class="footer__line">

    <section class="footer__section"><%= markdown_to_html(data.site.blurb) %></section>

    <% menu_items = data.site.footer_links_collection.items.compact %>
    <% if menu_items.present? %>
      <ul class="footer__menu" role="list">
        <% menu_items.each do |i| %>
          <li class="footer__menu-item">
            <%= shortcut_link(i) %>
          </li>
        <% end %>
        <%= partial 'partials/search_trigger', locals: { wrapper_class: 'footer__menu-item' } %>
        <%# #header is the true element at the top of the page, thus this link also works with no %>
        <%# JavaScript. %>
        <li class="footer__menu-item"><a href="#header" data-controller="back-to-top" data-action="click->back-to-top#go">Back to top</a></li>
      </ul>
    <% end %>

    <section class="footer__section"><%= footer_text %></section>
  </div>
</footer>
