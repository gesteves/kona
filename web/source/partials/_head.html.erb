<head>
  <%= partial 'partials/meta' %>
  <%= partial 'partials/open_graph_and_social' %>
  <%# page_content is the same object that `content` names, and it needs no defined? test on each %>
  <%# line. %>
  <% page = page_content %>
  <%= partial 'partials/schema/article', locals: { article: page } if page && published_post?(page) %>
  <%= partial 'partials/schema/site' %>
  <%= partial 'partials/schema/breadcrumb' if page && published_post?(page) %>
  <%= partial 'partials/schema/profile' if page && page.entry_type == 'Page' && page.slug == 'about' %>
  <%= partial 'partials/schema/collection' if page && page.template == '/tag.html' %>
  <%= partial 'partials/schema/blog' if page && page.template == '/articles.html' %>
  <% if data.respond_to?(:standard_site) && data.standard_site&.publication_uri.present? %>
    <link rel="site.standard.publication" href="<%= data.standard_site.publication_uri %>">
    <% if page && published_post?(page) && data.standard_site.did.present? %>
      <link rel="site.standard.document" href="at://<%= data.standard_site.did %>/site.standard.document/<%= document_rkey(page.sys.id) %>">
    <% end %>
  <% end %>
  <link rel="canonical" href="<%= canonical_url %>">
  <% alternate_feed_links.each do |feed| %>
    <link rel="alternate" type="application/atom+xml" title="<%= h feed[:title] %>" href="<%= feed[:href] %>" />
  <% end %>
  <%# The Markdown copy of a post, and the llms.txt that covers each page. These are the link
      relations of the llms.txt proposal. %>
  <% if page && published_post?(page) %>
    <link rel="alternate" type="text/markdown" href="<%= full_url(entry_markdown_path(page)) %>">
  <% end %>
  <link rel="describedby" href="<%= full_url('/llms.txt') %>">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <% if data.site.logo.present? %>
    <link rel="apple-touch-icon" href="<%= site_icon_url(w: 180) %>">
    <link rel="manifest" href="/manifest.json">
  <% end %>
  <%# The font faces above the fold. A browser finds them only after it parses site.css, thus a
      preload removes one round trip from the critical path. `crossorigin` is necessary, also for
      the same origin: a browser always gets a font in CORS mode, and without the attribute it
      downloads each font two times, with no message. Keep this list to the two or three faces
      that render above the fold. With more, they compete with the LCP image. %>
  <% %w[
    ibm-plex-sans-condensed-v14-latin-700.woff2
    lato-v24-latin-300.woff2
    ibm-plex-mono-v19-latin-300.woff2
  ].each do |font| %>
    <link rel="preload" as="font" type="font/woff2" href="<%= asset_path(:fonts, font) %>" crossorigin>
  <% end %>
  <%# This page does NOT load the stylesheet and the component module of Pagefind.
      javascripts/stimulus/lib/pagefind.js adds them on demand, and it gives the rule for the
      position of the stylesheet in this head. %>
  <%= javascript_include_tag 'site', defer: 'defer', 'data-turbo-track': 'reload' %>
  <%# The Web Awesome theme. esbuild takes it from the one CSS import in stimulus/index.js.
      It does NOT stop the first render: this element only preloads the file, and
      javascripts/stimulus/lib/wa_theme.js adds the <link rel="stylesheet"> when the bundle runs.
      The first paint does not need the file, and lib/wa_theme.js gives the reason.
      ⚠️ This element carries the URL, because asset_hash puts a hash in the name and the
      JavaScript cannot write it. Do not give it `data-turbo-track`, and never change one of its
      attributes at run time. Turbo puts the outerHTML of a tracked element in its signature, thus
      a change makes each navigation a full page load and stops the view transitions, with no
      message. %>
  <link rel="preload" as="style" data-wa-theme href="<%= asset_path(:css, '/javascripts/site') %>">
  <%= stylesheet_link_tag 'site', 'data-turbo-track': 'reload' %>
  <%= stylesheet_link_tag 'print', media: 'print', 'data-turbo-track': 'reload' %>
  <%= yield_content :assets %>
  <%= partial 'partials/analytics' %>
</head>
