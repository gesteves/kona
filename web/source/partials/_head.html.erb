<head>
  <%= partial 'partials/meta' %>
  <%= partial 'partials/open_graph_and_social' %>
  <%# page_content is the same object that `content` names, and it needs no defined? test on each %>
  <%# line. %>
  <% page = page_content %>
  <%= partial 'partials/schema/article', locals: { article: page } if page && published_post?(page) %>
  <%= partial 'partials/schema/site' %>
  <%= partial 'partials/schema/breadcrumb' if page && published_post?(page) %>
  <%= partial 'partials/schema/profile' if page && page.entry_type == 'Page' && page.slug == 'about' %>
  <%= partial 'partials/schema/collection' if page && page.template == '/tag.html' %>
  <%= partial 'partials/schema/blog' if page && page.template == '/articles.html' %>
  <% if data.respond_to?(:standard_site) && data.standard_site&.publication_uri.present? %>
    <link rel="site.standard.publication" href="<%= data.standard_site.publication_uri %>">
    <% if page && published_post?(page) && data.standard_site.did.present? %>
      <link rel="site.standard.document" href="at://<%= data.standard_site.did %>/site.standard.document/<%= document_rkey(page.sys.id) %>">
    <% end %>
  <% end %>
  <link rel="canonical" href="<%= canonical_url %>">
  <% alternate_feed_links.each do |feed| %>
    <link rel="alternate" type="application/atom+xml" title="<%= feed[:title] %>" href="<%= feed[:href] %>" />
  <% end %>
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <% if data.site.logo.present? %>
    <link rel="apple-touch-icon" href="<%= site_icon_url(w: 180) %>">
    <link rel="manifest" href="/manifest.json">
  <% end %>
  <%# The font faces above the fold. A browser finds them only after it parses site.css,
      so preloading them removes a round trip from the critical path. `crossorigin` is
      mandatory even same-origin — fonts always fetch in CORS mode, and omitting it
      silently doubles the download. Keep this list to the two or three faces that
      actually render above the fold; more, and they start competing with the LCP image. %>
  <% %w[
    ibm-plex-sans-condensed-v14-latin-700.woff2
    lato-v24-latin-300.woff2
    ibm-plex-mono-v19-latin-300.woff2
  ].each do |font| %>
    <link rel="preload" as="font" type="font/woff2" href="<%= asset_path(:fonts, font) %>" crossorigin>
  <% end %>
  <%# This page does NOT load the stylesheet and the component module of Pagefind. The code adds
      demand by javascripts/stimulus/lib/pagefind.js, which also documents the cascade
      constraint on where the stylesheet lands in this head. %>
  <%= javascript_include_tag 'site', defer: 'defer', 'data-turbo-track': 'reload' %>
  <%# The Web Awesome theme. esbuild takes it from the one CSS import in stimulus/index.js.
      ⚠️ This is render-blocking and it does NOT have to be — it's custom-property definitions
      only (it pulls in layers.css and a colour palette, but neither native.css nor
      utilities.css, so it styles no plain HTML element), and every token consumer is a WA
      custom element that can't render styled until the deferred bundle above upgrades it.
      But do NOT unblock it with the usual `media="print" onload="this.media='all'"` swap:
      `data-turbo-track="reload"` folds this element's outerHTML into Turbo's tracked-element
      signature (HeadSnapshot#trackedElementSignature), so mutating `media` at runtime makes
      every navigation's comparison fail and Turbo full-page-reloads, taking view transitions
      with it. That's been tried and reverted. Any fix must leave the element unmutated —
      inline the CSS in a <style>, or drop this tag and inject the <link> from JS the way
      lib/pagefind.js does. %>
  <%= stylesheet_link_tag '/javascripts/site', 'data-turbo-track': 'reload' %>
  <%= stylesheet_link_tag 'site', 'data-turbo-track': 'reload' %>
  <%= stylesheet_link_tag 'print', media: 'print', 'data-turbo-track': 'reload' %>
  <%= yield_content :assets %>
  <%= partial 'partials/analytics' %>
</head>
