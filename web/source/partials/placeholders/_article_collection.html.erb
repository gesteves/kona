<%# The shared placeholder of each article collection that the API puts in order: the trending
    collection and the related collection. It is a skeleton of a collection section. The
    live-update controller replaces it with the API fragment, and it removes the element when the
    API has nothing to show, that is, an empty response. The locals: `section_id` and `heading`,
    which must be the same as in the shared _collection partial of the API view, thus a reader does
    not see the change, and `url`, which is the API endpoint. %>
<section class="collection collection--halves" id="<%= section_id %>" aria-labelledby="hed-<%= section_id %>" data-nosnippet <%= live_update_attrs(url) %>>
  <h2 class="collection__heading" id="hed-<%= section_id %>"><%= heading %></h2>
  <ol class="collection__list" role="list">
    <% 4.times do %>
      <li class="collection__item">
        <%= partial 'partials/placeholders/entry_skeleton', locals: { image: true } %>
      </li>
    <% end %>
  </ol>
</section>
