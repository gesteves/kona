<%# The loading skeleton of one stat card. The label at the top, which is an icon and a name, %>
<%# does not change, thus it is true text. Only the number and the footer, which come from the %>
<%# data, are skeletons. It uses the true `.stats__stat` classes, thus each line keeps the same %>
<%# height and the layout does not change when the live-update controller puts the true markup %>
<%# here. %>
<div class="stats__stat stats__stat--skeleton">
  <span class="stats__meta"><%= icon_svg("classic", "light", icon) %> <%= top %></span>
  <span class="stats__number"><wa-skeleton effect="sheen"></wa-skeleton></span>
  <span class="stats__meta">
    <% if defined?(bottom) %>
      <%= bottom %>
    <% else %>
      <wa-skeleton effect="sheen"></wa-skeleton>
    <% end %>
  </span>
</div>
