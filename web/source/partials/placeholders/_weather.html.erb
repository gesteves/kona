<%# Loading skeleton mirroring the real weather layout (icon + text). The live-update %>
<%# controller swaps in the real markup on connect, or removes this shell when there's %>
<%# no current weather (empty response). `url` (required local) is the API endpoint. %>
<div class="weather" data-nosnippet <%= live_update_attrs(url) %>>
  <%# aria-hidden matches the api fragment that replaces this — see widgets/weather/current. %>
  <div class="weather__icon" aria-hidden="true"><wa-skeleton class="weather-skeleton-icon" effect="sheen"></wa-skeleton></div>
  <div class="weather__text">
    <wa-skeleton class="weather-skeleton-text" effect="sheen"></wa-skeleton>
    <wa-skeleton class="weather-skeleton-text" effect="sheen"></wa-skeleton>
    <wa-skeleton class="weather-skeleton-text" effect="sheen"></wa-skeleton>
    <wa-skeleton class="weather-skeleton-text" effect="sheen"></wa-skeleton>
  </div>
</div>
