<section class="collection <%= "collection--#{variant}" if defined?(variant) %>" <% if title.present? %>id="<%= title.parameterize %>"<% end %>>
  <% if title.present? %>
    <h2 class="collection__heading"><%= smartypants(title) %></h2>
  <% end %>
  <ol class="collection__list">
    <%# Filter before the <li>, not inside it — otherwise a non-post item emits an empty one. %>
    <% items.select { |item| blog_post?(item) }.each do |item| %>
      <li class="collection__item">
        <%= partial 'partials/article/summary', locals: { article: item } %>
      </li>
    <% end %>
  </ol>
</section>
