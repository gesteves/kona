<% if production? && plausible_installed? %>
  <%# Set the Plausible configuration here, before the deferred script loads. Thus our settings, %>
  <%# which are the manual page views and the first-party endpoint, apply before the script can %>
  <%# start with its own defaults, which are autoCapturePageviews:true and the public endpoint. %>
  <script>
    window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments) };
    window.plausible.init = window.plausible.init || function (i) { window.plausible.o = i || {} };
    plausible.init({ autoCapturePageviews: false, endpoint: '<%= plausible_event_path %>' });
  </script>
  <script defer src="<%= plausible_script_path %>"></script>
<% end %>
