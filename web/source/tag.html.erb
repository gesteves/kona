<div class="blog">
  <header class="blog__header">
    <p class="entry__meta">
      <% if content.published_at %>
        <% latest = DateTime.parse(content.published_at) %>
        <span>
          <%= icon_svg("classic", "light", "calendar") %>
          Updated <%= content_tag :time, latest.strftime('%B %-e, %Y'), datetime: latest.iso8601 %>
        </span>
      <% end %>
      <% ancestors = content.tag_id ? concept_chain(content.tag_id)[0...-1] : [] %>
      <% if ancestors.any? %>
        <span>
          <%= tag_list_icon(ancestors.size) %>
          <span role="list" aria-label="Category">
            <%= tag_chain_links(ancestors.map { |node| [node[:name], node[:path]] }) %>
          </span>
        </span>
      <% end %>
    </p>
    <%# ⚠️ data-pagefind-body is on the heading, and not on the full page. Thus the site search can
        find the archive by its name, and it does not index the list of entries below. With that
        list in the index, the intro of each article would also go under each of its tag pages, and
        one search would then give the same text more than one time. The heading is always there,
        thus the search also finds an archive whose concept has no description. %>
    <h1 id="hed" class="blog__hed" data-pagefind-body data-pagefind-meta="title">
      <%= smartypants(content.title) %>
    </h1>
    <p class="entry__meta">
      <% if content.tag_id %>
        <span>
          <a href="<%= taxonomy_index.dig(content.tag_id, :path) %>feed.xml" data-controller="clipboard" data-action="click->clipboard#copy" data-clipboard-success-message-value="A link to this section’s feed has been copied to your clipboard.">
            <%= icon_svg("classic", "light", "rss") %> Feed
          </a>
        </span>
      <% end %>
    </p>
  </header>

  <% if content.description.present? %>
    <div class="blog__description" data-pagefind-body><%= render_tag_description(content.description) %></div>
  <% end %>

  <%= partial 'partials/blog_list', locals: { content: content } %>
</div>
