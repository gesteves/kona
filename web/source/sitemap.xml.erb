<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <% data.pages.reject { |a| a.draft || !a.index_in_search_engines }.each do |page| %>
    <url>
      <loc><%= full_url(page.path) %></loc>
      <% if page.is_home_page %>
        <lastmod><%= site_updated_at.strftime('%Y-%m-%d') %></lastmod>
      <% else %>
        <lastmod><%= DateTime.parse(page.updated_at).strftime('%Y-%m-%d') %></lastmod>
      <% end %>
    </url>
  <% end %>
  <% data.articles.reject { |a| a.draft || !a.index_in_search_engines }.each do |article| %>
    <url>
      <loc><%= full_url(article.path) %></loc>
      <lastmod><%= DateTime.parse(article.updated_at).strftime('%Y-%m-%d') %></lastmod>
    </url>
  <% end %>
  <%# Listing hubs — the blog index and per-tag pages (both paginated). They have no
      updated_at of their own, so lastmod is the newest entry each page lists. %>
  <% (data.blog + data.tags.flat_map(&:pages)).select { |p| p.index_in_search_engines }.each do |page| %>
    <url>
      <loc><%= full_url(page.path) %></loc>
      <% latest = Array(page.items).filter_map { |i| DateTime.parse(i.updated_at) if i.updated_at.present? }.max %>
      <% if latest %>
        <lastmod><%= latest.strftime('%Y-%m-%d') %></lastmod>
      <% end %>
    </url>
  <% end %>
</urlset>
