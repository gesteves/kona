---
title: Page not found.
summary: I'm sorry, but the page you were looking for can't be found.
body: I'm sorry, but the page you were looking for can't be found.
---

<%# No aria-labelledby: a bare <div> has no role, so the label is discarded. The <h1> inside
    already names the page. %>
<div class="home">
  <section class="home__intro">
    <h1 class="home__headline" id="hed">
      <%= smartypants(current_page.data.title) %>
    </h1>
    <div class="home__body">
      <%= smartypants(markdown_to_html(current_page.data.body)) %>
    </div>
    </section>
    <% recent = recent_articles %>
    <% if recent.present? %>
      <%= partial 'partials/collection', locals: { title: "Recent Articles", items: recent, variant: "centered" } %>
    <% end %>
</div>
