---
title: Page not found.
summary: I'm sorry, but the page you were looking for can't be found.
body: I'm sorry, but the page you were looking for can't be found.
# Cloudflare serves this body with a 404 status, thus a search engine must not index it under the
# URL that the crawler asked for. This page has no proxied content object, thus the flag is here.
index_in_search_engines: false
---

<%# There is no aria-labelledby: a plain <div> has no role, thus the browser ignores the label.
    The <h1> in it already names the page. %>
<div class="home">
  <section class="home__intro">
    <h1 class="home__headline" id="hed">
      <%= smartypants(current_page.data.title) %>
    </h1>
    <div class="home__body">
      <%= smartypants(markdown_to_html(current_page.data.body)) %>
    </div>
    </section>
    <% recent = recent_articles %>
    <% if recent.present? %>
      <%= partial 'partials/collection', locals: { title: "Recent Articles", items: recent, variant: "centered", tracking_section: "Recent Articles (404)" } %>
    <% end %>
</div>
