<%# There is no aria-labelledby: a plain <div> has no role, thus the browser ignores the label.
    The <h1> in it already names the page. %>
<div class="home">
  <section class="home__intro">
    <h1 class="home__headline" id="hed">
      <%= heading_text(content.title) %>
    </h1>
    <div class="home__body">
      <%= render_home_body(content.body) %>
    </div>
  </section>
  <%= render_widget 'stats', '/widgets/activity-stats' %>
  <% recent = recent_articles %>
  <% if recent.present? %>
    <%= partial 'partials/collection', locals: { title: "Recent Articles", items: recent, variant: "halves" } %>
  <% end %>
  <%= render_widget 'whoop', '/widgets/whoop' %>
  <%= render_widget 'trending', '/widgets/articles/trending' %>
  <%= render_widget 'weather', '/widgets/weather/current' %>
  <% if data.events.present? %>
    <%# This is not a partial in placeholders/, thus the code renders it directly and not with %>
    <%# render_widget. %>
    <%= partial 'partials/upcoming_races', locals: { url: '/widgets/events/upcoming' } %>
  <% end %>
</div>
