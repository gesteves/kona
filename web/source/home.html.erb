<div class="home" aria-labelledby="hed">
  <section class="home__intro">
    <h1 class="home__headline" id="hed">
      <%= smartypants(content.title) %>
    </h1>
    <div class="home__body">
      <%= render_home_body(content.body) %>
    </div>
  </section>
  <% stats_url = "/widgets/activity-stats" %>
  <% preload_widget stats_url %>
  <%= partial 'partials/placeholders/stats', locals: { url: stats_url } %>
  <% recent = recent_articles %>
  <% if recent.present? %>
    <%= partial 'partials/collection', locals: { title: "Recent Articles", items: recent, variant: "halves" } %>
  <% end %>
  <% whoop_url = "/widgets/whoop" %>
  <% preload_widget whoop_url %>
  <%= partial 'partials/placeholders/whoop', locals: { url: whoop_url } %>
  <% trending_url = "/widgets/articles/trending" %>
  <% preload_widget trending_url %>
  <%= partial 'partials/placeholders/trending', locals: { url: trending_url } %>
  <% weather_url = "/widgets/weather/current" %>
  <% preload_widget weather_url %>
  <%= partial 'partials/placeholders/weather', locals: { url: weather_url } %>
  <% if data.events.present? %>
    <% races_url = "/widgets/events/upcoming" %>
    <% preload_widget races_url %>
    <%= partial 'partials/upcoming_races', locals: { url: races_url } %>
  <% end %>
</div>
