<%=
  # The logo URL is Contentful's original, NOT cdn_image_url: the build-time OG renderer
  # (scripts/render-og.mjs) downloads it directly, so the build never depends on the zone
  # being up or spends a transformation slot — and satori can't decode webp or avif anyway,
  # so the source PNG (whose transparency has to survive) is exactly what it needs.
  {
    logoUrl: data.site.small_logo&.url,
    titles: og_page_titles
  }.to_json
%>
