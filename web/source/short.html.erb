<%= partial 'partials/article/short', locals: { article: content, indexable: true } %>
<%= partial 'partials/share', locals: { article: content } %>
<%# Shorts have no event, so they always show the semantically-related "You May Also Like" section. %>
<%= partial 'partials/related', locals: { article: content } %>
<%# Exclude only this entry so trending doesn't repeat it. %>
<%= render_widget 'trending', "/widgets/articles/trending/#{content.sys.id}" %>
<%= partial 'partials/read_next', locals: { article: content } %>
