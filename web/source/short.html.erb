<%= partial 'partials/article/short', locals: { article: content, indexable: true } %>
<%= partial 'partials/share', locals: { article: content } %>
<%# Shorts have no event, so they always show the semantically-related "You May Also Like" widget. %>
<% related_url = "/api/articles/related/#{content.sys.id}" %>
<% preload_widget related_url %>
<%= partial 'partials/placeholders/related', locals: { url: related_url } %>
<%# Exclude only this entry so trending doesn't repeat it. %>
<% trending_url = "/api/articles/trending/#{content.sys.id}" %>
<% preload_widget trending_url %>
<%= partial 'partials/placeholders/trending', locals: { url: trending_url } %>
<%= partial 'partials/read_next', locals: { article: content } %>
