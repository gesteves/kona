source "https://rubygems.org"
ruby "4.0.6"

gem "middleman", "~> 4.6"
gem "middleman-autoprefixer", "~> 3.0"
gem "tzinfo-data", platforms: [ :mswin, :mingw, :jruby ]
gem "wdm", "~> 0.1", platforms: [ :mswin, :mingw ]

gem "middleman-dotenv"
gem "middleman-minify-html"
gem "dotenv"
gem "rake"
gem "graphql-client"
gem "nokogiri"
gem "redcarpet"
gem "activesupport"
gem "sanitize"
gem "public_suffix"
gem "httparty"
gem "redis"
# Pinned to a ref, not a moving branch: `ref` is what makes `bundle update` reproducible, since
# a git source is resolved fresh from the remote rather than from rubygems.
gem "blurhash", git: "https://github.com/gesteves/blurhash", ref: "8c7700513460f748596a43609bae3f12a6400974"
gem "ruby-vips"
gem "ostruct"
gem "htmlentities"
gem "humanize"

group :development, :test do
  gem "rspec"
  # Rails' own RuboCop ruleset. This isn't a Rails app, but the ruleset is a general Ruby style
  # config and using the same one in both apps keeps the monorepo consistent. See .rubocop.yml.
  gem "rubocop-rails-omakase", require: false
  # Scans the bundle for gems with known CVEs; run by the security job in web.yml. This app's
  # build-time dependencies parse untrusted content (nokogiri, redcarpet, sanitize), so it wants
  # the same CVE gate the api has had.
  gem "bundler-audit", require: false
end
