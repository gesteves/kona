######################################
# The variables below are all REQUIRED
######################################

# Retrieves blog content from Contentful.
CONTENTFUL_SPACE=
CONTENTFUL_TOKEN=

# The site's public origin, e.g. https://<your-site-host>. root_url reads it on a production
# build (DEPLOY_CONTEXT == "production"), so every canonical, feed and og:image URL is built
# from it. Nothing injects it automatically — set it explicitly in the build env
# (.github/workflows/web.yml) or those URLs come out empty. Leave unset locally: a
# non-production build falls back to http://localhost:4567.
URL=

# Used for caching. Use rediss:// for TLS (e.g. Upstash).
REDIS_URL=

# Base URL of the kona-api service. Used by the /widgets/* proxy and, at build time, to fetch
# icons (POST /api/icons) and the standard.site verification data (GET /api/standard-site).
# The Font Awesome integration (token + version) now lives entirely in the api.
KONA_API_URL=

# Shared bearer token the api proxy (src/api-proxy.ts) injects on every upstream request
# (widgets + the contact-form POST); must match the kona-api app's API_TOKEN. Needed in TWO
# places: the build env (.github/workflows/web.yml, for the POST /api/icons fetch) and the
# Worker's dashboard secrets — without the latter every widget 401s at the origin and
# collapses on the site.
API_TOKEN=

# Host that serves the image transformations, e.g. https://<your-site-host>. Images are resized
# by Cloudflare Images, which serves them from a host it fronts (<host>/cdn-cgi/image/...), so
# this is the site's public host. REQUIRED everywhere, including locally — building an image
# without it raises. Set it in the build env too. (It used to fall back to Contentful's resizing
# when unset, which rendered a fine-looking site while draining Contentful's bandwidth, so a
# broken deploy looked healthy. It fails loudly now instead.) Point it at the real zone locally
# and `middleman server` renders what production serves: auto avif/webp, cover images cropped to
# the Open Graph size.
IMAGES_URL=

# REQUIRED, everywhere including locally. Bare hostname (no scheme, no path) of the R2 bucket
# mirroring Contentful's image assets, e.g. images.<your-site-host>. Asset URLs get their host
# swapped to this, so Cloudflare Images fetches the untransformed source from inside our own zone
# instead of from Contentful — a source outside the zone can't use Tiered Cache or Cache Reserve,
# so every PoP was pulling full-size originals from Contentful.
# ⚠️ NOT optional and NOT a rollback switch. The zone's Transformations source allowlist names
# only this host; *.ctfassets.net is deliberately absent and must never be added. So leaving this
# unset doesn't fall back to Contentful — it 403s every image on the site, blurhash thumbnails
# included. (Allowlisting ctfassets to make the unset case "work" is the same trap the IMAGES_URL
# fallback was deleted for: the site looks perfect while billing Contentful's metered bandwidth.)
# ⚠️ Setting this ASSERTS the mirror is populated: these URLs 404 until it is. The api owns the
# mirror (AssetMirror, webhook-driven); run its `rake assets:backfill` to completion first, and
# make sure this names the custom domain on the bucket the api writes to — nothing validates it.
IMAGE_HOST=

######################################
# The variables below are all OPTIONAL
######################################

# Upstream URL of the site-specific Plausible analytics script, proxied first-party from
# /pa/*. Unset, the analytics snippet and proxy rules are simply not emitted
# (plausible_installed?). Set in the production build env; rarely needed locally.
PLAUSIBLE_SCRIPT_URL=

# The deploy context: "production" on the real public-site build, anything else (or unset)
# for local development. Read by lib/helpers/context_helpers.rb, and it gates the canonical
# URLs, feeds and the analytics snippet — so it MUST be set in the build env
# (.github/workflows/web.yml sets it). Leave unset locally.
DEPLOY_CONTEXT=


# IANA timezone the site's publish dates are reckoned in (the owner's location), e.g.
# America/Denver. The publish-date controller uses it for "published today", the clock-vs-calendar
# icon and the "New" badge, so they flip at the same instant for every reader. Unset, each reader
# gets their own browser timezone — a post published at 9pm Pacific reads as "not today" in Europe
# immediately. Set it in the build env (.github/workflows/web.yml) for it to reach production.
TIME_ZONE=

# Words per minute used for the "N minute read" estimate. Defaults to 200.
READING_TIME_WPM=

# Local debugging knob: shifts EVERY imported event's date by this many days from now, so the
# race-day states (featured card, race-day weather, "in progress") can be exercised without
# editing Contentful. ⚠️ Leave unset anywhere that builds real pages — it rewrites the content,
# not just the view.
DEBUG_EVENT_DATE=

# Public Cloudflare Turnstile sitekey for the contact form's bot challenge. Embedded in the widget
# (safe to expose). When unset, no widget renders and the api skips verification — pair it with the
# api app's TURNSTILE_SECRET (set both together or neither). Set it in the build env too.
TURNSTILE_SITE_KEY=
