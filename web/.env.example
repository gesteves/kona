######################################
# The variables below are all REQUIRED
######################################

# Retrieves blog content from Contentful.
CONTENTFUL_SPACE=
CONTENTFUL_TOKEN=

# Used for caching. Use rediss:// for TLS (e.g. Upstash).
REDIS_URL=

# Base URL of the kona-api service. Used by the /widgets/* proxy and, at build time, to fetch
# icons (POST /api/icons) and the standard.site verification data (GET /api/standard-site).
# The Font Awesome integration (token + version) now lives entirely in the api.
KONA_API_URL=

# Shared bearer token the api proxy (netlify/functions/api-proxy.mts) injects on every upstream
# request (widgets + the contact-form POST); must match the kona-api app's API_TOKEN. Set it in
# Netlify's env too, or every widget 401s at the origin and collapses on the site.
API_TOKEN=

# Host that serves the image transformations, e.g. https://<your-site-host>. Images are resized
# by Cloudflare Images, which serves them from a host it fronts (<host>/cdn-cgi/image/...), so
# this is the site's public host. REQUIRED everywhere, including locally — building an image
# without it raises. Set it in Netlify's env too. (It used to fall back to Contentful's resizing
# when unset, which rendered a fine-looking site while draining Contentful's bandwidth, so a
# broken deploy looked healthy. It fails loudly now instead.) Point it at the real zone locally
# and `middleman server` renders what production serves: auto avif/webp, cropped Open Graph cards.
IMAGES_URL=

######################################
# The variables below are all OPTIONAL
######################################

# Used by the Known Agents edge function to record bot/AI-agent page views.
DARK_VISITORS_ACCESS_TOKEN=

# Used ONLY by the `build:stop` / `build:activate` / `build:status` / `build:deploy` npm scripts
# (scripts/netlify-builds.js) to stop and re-activate Netlify builds outside the normal git flow —
# e.g. a content freeze. Not used by the site build itself.
# NETLIFY_AUTH_TOKEN: a personal access token (Netlify → User settings → Applications → New token).
# NETLIFY_SITE_ID: the site's API ID (Site configuration → General → Site information → Site ID).
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# The variables below are only used by the `rake maps:generate` task, which uploads GPX
# tracks to Mapbox and renders them as static map images.
# Token used to render the static map image.
MAPBOX_ACCESS_TOKEN=
# Mapbox account username; required to upload GPX tracks as tilesets.
MAPBOX_USERNAME=
# Secret token with `tilesets:write` and `tilesets:read` scopes; required to upload GPX
# tracks and to render the private tilesets it creates.
MAPBOX_SECRET_TOKEN=
