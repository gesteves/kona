{
  "name": "kona-contentful-migrations",
  "private": true,
  "description": "One-off Contentful content migrations for the Kona blog. Lives outside web/ so edits here don't trigger Netlify builds.",
  "scripts": {
    "backup": "node --env-file=.env scripts/backup.js",
    "fix:degrees": "node --env-file=.env scripts/fix-degrees.js",
    "migrate:headings": "node --env-file=.env scripts/bump-heading-levels.js",
    "migrate:headings:revert": "node --env-file=.env scripts/revert-heading-levels.js",
    "taxonomy:preview": "node scripts/preview-taxonomy.js",
    "taxonomy:create": "node --env-file=.env scripts/create-taxonomy.js",
    "taxonomy:describe": "node --env-file=.env scripts/set-descriptions.js",
    "taxonomy:delete": "node --env-file=.env scripts/delete-taxonomy.js",
    "taxonomy:assign": "node --env-file=.env scripts/assign-concepts.js",
    "taxonomy:unassign": "node --env-file=.env scripts/unassign-concepts.js",
    "taxonomy:validate-article": "node --env-file=.env scripts/add-taxonomy-validation.js",
    "taxonomy:validate-article:revert": "node --env-file=.env scripts/revert-taxonomy-validation.js",
    "taxonomy:redirects": "node --env-file=.env scripts/create-redirects.js"
  },
  "dependencies": {
    "contentful-management": "^11.0.0",
    "contentful-migration": "^5.0.0"
  }
}
