.DS_Store

# Overmind's control socket, created by `overmind start`
.overmind.sock

# ⚠️ Env files, ignored repo-wide rather than per app. Each app has its own .gitignore covering
# its own .env, which leaves anything outside them unguarded — deleting a directory's .gitignore
# silently un-ignores the .env sitting next to it, which is exactly how a Mapbox secret nearly
# got pushed. Committed examples (.env.example) are deliberately still tracked.
.env
.env.*
!.env.example
