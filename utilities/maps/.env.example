# Credentials for `rake maps:generate`, which uploads GPX tracks to Mapbox as private
# vector tilesets and renders them as static map images. Nothing here is used by the
# `web/` or `api/` apps — this is a local-only utility.

# Token used to render the static map image.
MAPBOX_ACCESS_TOKEN=

# Mapbox account username; required to upload GPX tracks as tilesets.
MAPBOX_USERNAME=

# Secret token with `tilesets:write` and `tilesets:read` scopes; required to upload GPX
# tracks and to render the private tilesets it creates.
MAPBOX_SECRET_TOKEN=

# OPTIONAL. The Mapbox style the image is rendered against.
# Default: mapbox://styles/mapbox/outdoors-v12
MAPBOX_STYLE_URL=
