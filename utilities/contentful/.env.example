# Contentful space id (same value as web/.env's CONTENTFUL_SPACE).
CONTENTFUL_SPACE=

# Personal Content Management API token, used only by these one-off migration scripts.
# Generate in Contentful under Settings → API keys → Content management tokens.
CONTENTFUL_MANAGEMENT_TOKEN=

# Contentful organization id — required ONLY by the taxonomy CRUD scripts
# (taxonomy:create / taxonomy:delete), because concept schemes and concepts are managed
# at the organization level, not per space/environment. Find it in the Contentful URL
# (…/organizations/<id>/…) or under Organization settings. Not needed by the other scripts.
CONTENTFUL_ORGANIZATION_ID=
