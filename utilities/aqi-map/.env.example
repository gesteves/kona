# Credentials for the AQI map page. Nothing here is used by the `web/` or `api/` apps, or by
# `utilities/maps/` — this runs locally only, and its own `.env` is gitignored.

# Mapbox PUBLIC access token (pk.…). It is inlined into the page's HTML, so it must be the
# public one, not a secret token.
MAPBOX_ACCESS_TOKEN=

# PurpleAir READ key. Sensor discovery and history are both GETs, so a read key is enough.
PURPLEAIR_API_KEY=

# OPTIONAL. The Mapbox style the map is rendered with. Same variable name and same default as
# utilities/maps, so screenshots from here match the static GPX maps.
# Default: mapbox://styles/mapbox/outdoors-v12
MAPBOX_STYLE_URL=
