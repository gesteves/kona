# The keys of the race weather tool. It runs on your own machine only, and git ignores its .env.
# The api uses the same services, thus you can copy each value from api/.env.

# Google Maps. The key needs the Geocoding API and the Time Zone API.
GOOGLE_API_KEY=

# Apple WeatherKit. The private key is the .p8 file, encoded as base64, as in the api.
WEATHERKIT_KEY_ID=
WEATHERKIT_TEAM_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_PRIVATE_KEY=

# PurpleAir READ key. Without it, the AQI column says "No data".
PURPLEAIR_API_KEY=

# OPTIONAL. Claude writes the Weather column. Without a key, that column gives the most common
# sky condition of the day.
ANTHROPIC_API_KEY=
# OPTIONAL. Default: claude-sonnet-5-5
ANTHROPIC_MODEL=
