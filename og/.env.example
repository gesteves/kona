# kona-og environment. Copy to .env for local dev; never commit values.
# In production these are fly secrets/vars on the kona-og app, not committed here.

####################
# REQUIRED
####################

# Comma-separated allowlist of site origins the `url` param may point at (production plus
# any preview origin). A request whose url isn't on one of these is rejected before any
# fetch. NEVER hardcode the production hostname; this is environment-specific.
# e.g. SITE_URL=https://<your-site-host>,https://<your-preview-host>
SITE_URL=

####################
# OPTIONAL
####################

# Port the HTTP server binds to. Defaults to 3000 (matches fly.toml internal_port).
PORT=
