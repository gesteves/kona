OVERMIND_PROCFILE=Procfile.dev

# Sidekiq is opt-in (`overmind start -l web,api,worker`): no widget endpoint enqueues a job, so
# it's only wanted when exercising webhooks or POST /api/location.
OVERMIND_IGNORED_PROCESSES=worker

# Without this, one process exiting stops all of them. The site preview doesn't need the api —
# DevApiProxy degrades to a 502 and the widgets collapse — so a Rails boot failure shouldn't take
# Middleman down with it. `web` is deliberately not listed: if it dies, stopping is correct.
OVERMIND_CAN_DIE=api,worker

# ⚠️ This is what makes `overmind start` mean "the whole stack, locally". Child processes inherit
# it, and dotenv does not overwrite an already-set variable, so it beats web/.env — which is how
# plain `bundle exec middleman` still targets the deployed api with no flag on either command.
KONA_API_URL=http://localhost:3000

# The api builds the contact form's no-JS redirect from this (Api::ContactController#site_url).
# Unset, Rails makes it absolute against the api's own host, so submitting without JS lands on
# localhost:3000/contact/success — a page only the site serves.
SITE_URL=http://localhost:4567
